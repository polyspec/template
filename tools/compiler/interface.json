    },
    {
      "name": "lowerSourceGraph",
      "owner": "Compiler",
      "parameters": [
        "canonical AST graph",
        "TypeManifest"
      ],
      "returns": "TypedProgram"
    },
    {
      "name": "emitArtifact",
      "owner": "Compiler",
      "parameters": [
        "TypedProgram",
        "CompileMode",
        "LanguageBackend"
      ],
      "returns": "ArtifactManifest and files"
    },
    {
      "name": "emitDeclarations",
      "owner": "LanguageBackend",
      "parameters": [
        "TypedProgram"
      ],
