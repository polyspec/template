        "LanguageBackend"
      ],
      "returns": "ArtifactManifest"
    },
    {
      "name": "loadOrRefresh",
      "owner": "ArtifactStore",
      "parameters": [
        "CompileMode",
        "ArtifactRefresh"
      ],
      "returns": "Program"
    },
    {
      "name": "prepare",
      "owner": "Program",
      "parameters": [
        "RenderRequest"
      ],
      "returns": "PreparedRender"
    },
    {
      "name": "render",
      "owner": "Program",
      "parameters": [
        "RenderRequest"
      ],
      "returns": "UTF-8 string"
    },
    {
      "name": "get",
      "owner": "PageCache",
      "parameters": [
        "cacheKey"
      ],
      "returns": "UTF-8 string or miss"
    },
    {
      "name": "put",
      "owner": "PageCache",
      "parameters": [
        "cacheKey",
        "html",
        "ttl"
      ],
      "returns": "void"
    },
    {
      "name": "getOrSet",
      "owner": "PageCache",
      "parameters": [
        "cacheKey",
        "ttl",
        "render"
      ],
      "returns": "UTF-8 string"
    },
    {
      "name": "limits",
      "owner": "RuntimeServices",
      "parameters": [],
      "returns": "Limits"
    },
    {
      "name": "hostFunction",
      "owner": "RuntimeServices",
      "parameters": [
        "name"
      ],
      "returns": "HostFunction or missing"
    }
  ],
