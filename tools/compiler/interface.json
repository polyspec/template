  "forbidden": [
    "generated renderer callback",
    "AST fallback from generated mode",
    "showcase-specific compiler",
    "legacy wrapper compatibility",
    "parsing or code generation during render"
  ],
  "showcaseAdapter": {
    "schema": 3,
    "name": "RenderAdapter",
    "concreteType": "Adapter",
    "supportLevels": {
      "core-runtime": {
        "description": "Renders an already loaded template with assign and define data.",
        "operations": [
          "render"
        ]
      },
      "source-compiler": {
        "description": "Parses source templates and produces the canonical AST artifact.",
        "operations": [
          "parse",
          "encodeArtifact"
        ]
      },
      "artifact-runtime": {
        "description": "Loads canonical AST artifacts without parsing source templates.",
        "operations": [
          "loadArtifact",
          "render"
        ]
      },
      "generated-compiler": {
        "description": "Compiler that emits typed executable source for the selected host language.",
        "operations": [
          "compileNative",
          "loadNative"
        ]
      }
    },
    "executionModes": {
      "ast": {
        "description": "Load the canonical AST artifact once and interpret it for each render.",
        "input": "canonical AST artifact",
        "requestPath": [
          "loadArtifact",
          "bind assign and define",
          "render AST"
        ],
        "requiredSupportLevel": "artifact-runtime",
        "status": "implemented"
      },
      "generated": {
        "description": "Lower canonical AST nodes into executable host-language renderer source before startup and call it at runtime.",
        "input": "generated host-language source",
        "requestPath": [
          "lower AST nodes",
          "compileNative",
          "loadNative",
          "bind assign and define",
          "call generated renderer"
        ],
        "requiredSupportLevel": "generated-compiler",
        "status": "implemented"
      }
    },
    "artifactRefresh": {
      "dev": "Refresh the selected compiled artifact on every call.",
      "true": "Reuse the artifact until its source version changes.",
      "false": "Use the deployed artifact without runtime refresh."
    },
    "pageCache": {
      "ttl": "Positive seconds expire; 0 and null mean forever.",
      "hit": "Returns final HTML before business logic and template rendering."
    },
    "constructor": {
      "parameters": [
        {
          "name": "root",
          "type": "path",
          "mode": "owned"
        }
      ],
      "returns": "Adapter",
      "errors": [
        "ContractError"
      ],
      "preconditions": [
        "root contains scenario.json",
        "scenario.json is valid JSON"
      ],
      "reads": [],
      "mutates": [
        "Adapter.engine configuration"
      ],
      "owns": [
        "Adapter.root",
        "Adapter.engine"
      ]
    },
    "types": {
      "JsonValue": {
        "kind": "recursive-union",
        "variants": [
          "null",
          "boolean",
          "number",
          "string",
          "array<JsonValue>",
          "ordered-object<string, JsonValue>"
        ]
      },
      "JsonObject": {
        "kind": "alias",
        "type": "ordered-object<string, JsonValue>"
      },
      "DefineRegistry": {
        "kind": "alias",
        "type": "ordered-map<string, string | DefineEntry>",
        "invariant": "a string is the canonical template path; DefineEntry is reserved for template data or an HTML slot"
      },
      "DefineEntry": {
        "kind": "union",
        "order": [
          "template",
          "html"
        ],
        "variants": [
          {
            "name": "template",
            "fields": [
              {
                "name": "template",
                "type": "string",
                "nullable": false,
                "required": true,
                "order": 1
              },
              {
                "name": "data",
                "type": "JsonObject",
                "nullable": false,
                "required": false,
                "order": 2
              }
            ],
            "owns": [
              "template",
              "data"
            ]
          },
          {
            "name": "html",
            "fields": [
              {
                "name": "html",
                "type": "string",
                "nullable": false,
                "required": true,
                "order": 1
              }
            ],
            "owns": [
              "html"
            ]
          }
        ],
        "invariant": "exactly one variant is present; html cannot carry data"
      },
      "Environment": {
        "kind": "record",
        "fields": [
          {
            "name": "timezone",
            "type": "string",
            "nullable": false,
            "required": false,
            "order": 1
          },
          {
            "name": "now",
            "type": "number",
            "nullable": false,
            "required": false,
            "order": 2
          }
        ],
        "invariant": "omitted values use the engine defaults"
      },
      "Scenario": {
        "kind": "record",
        "fields": [
          {
            "name": "target",
            "type": "string",
            "nullable": false,
            "required": true,
            "order": 1,
            "owns": "Scenario.target"
          },
          {
            "name": "assign",
            "type": "JsonObject",
            "nullable": false,
            "required": true,
            "order": 2,
            "owns": "Scenario.assign"
          },
          {
            "name": "define",
            "type": "DefineRegistry",
            "nullable": false,
            "required": true,
            "order": 3,
            "owns": "Scenario.define"
          },
          {
            "name": "env",
            "type": "Environment",
            "nullable": false,
            "required": false,
            "order": 4,
            "owns": "Scenario.env"
          }
        ],
        "invariant": "assign and define are decoded from the scenario files without renaming or reshaping"
      },
      "RenderRequest": {
        "kind": "record",
        "fields": [
          {
            "name": "target",
            "type": "string",
            "nullable": false,
            "required": true,
            "order": 1,
            "from": "Scenario.target"
          },
          {
            "name": "assign",
            "type": "JsonObject",
            "nullable": false,
            "required": true,
            "order": 2,
            "from": "Scenario.assign"
          },
          {
            "name": "define",
            "type": "DefineRegistry",
            "nullable": false,
            "required": true,
            "order": 3,
            "from": "Scenario.define"
          },
          {
            "name": "env",
            "type": "Environment",
            "nullable": false,
            "required": false,
            "order": 4,
            "from": "Scenario.env"
          }
        ],
        "invariant": "render reads the request and leaves every field unchanged"
      },
      "RepeatResult": {
        "kind": "record",
        "fields": [
          {
            "name": "first",
            "type": "string",
            "nullable": false,
            "required": true,
            "order": 1
          },
          {
            "name": "second",
            "type": "string",
            "nullable": false,
            "required": true,
            "order": 2
          }
        ],
        "invariant": "first and second must have identical UTF-8 bytes"
      }
    },
    "operations": [
      {
        "name": "loadScenario",
        "parameters": [],
        "returns": "Scenario",
        "errors": [
          "ContractError"
        ],
        "preconditions": [
          "Adapter.root exists",
          "scenario.json, data.json and define.json are readable"
        ],
        "mutates": [],
        "calls": [],
        "failureState": "Adapter remains ready"
      },
      {
        "name": "buildRequest",
        "parameters": [
          {
            "name": "scenario",
            "type": "Scenario",
            "mode": "read-only"
          }
        ],
        "returns": "RenderRequest",
        "errors": [
          "ContractError"
        ],
        "preconditions": [
          "scenario.target is a non-empty string",
          "scenario.assign is an object",
          "scenario.define is an ordered map"
        ],
        "mutates": [],
        "calls": [],
        "failureState": "Adapter remains ready; scenario remains unchanged"
      },
      {
        "name": "render",
        "parameters": [
          {
            "name": "request",
            "type": "RenderRequest",
            "mode": "read-only"
          }
        ],
        "returns": "string",
        "errors": [
          "RenderError"
        ],
        "preconditions": [
          "request.target is a loader name or a registered template target"
        ],
        "mutates": [
          "Adapter.engine cache only"
        ],
        "calls": [
          "Engine.render(request.target, request.assign, request.define, request.env)"
        ],
        "failureState": "Adapter.engine output is discarded; request remains unchanged"
      },
      {
        "name": "renderTwice",
        "parameters": [
          {
            "name": "request",
            "type": "RenderRequest",
            "mode": "read-only"
          }
        ],
        "returns": "RepeatResult",
        "errors": [
          "RenderError"
        ],
        "preconditions": [
          "request satisfies render preconditions"
        ],
        "mutates": [
          "Adapter.engine cache only"
        ],
