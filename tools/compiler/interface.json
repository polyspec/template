{
  "schema": 2,
  "name": "TemplateCompiler",
  "purpose": "Define one compiler, artifact and program contract followed by every core language.",
  "supportLevels": {
    "core": {
      "languages": [
        "typescript",
        "go",
        "rust",
        "php"
      ],
      "compileModes": [
        "ast",
        "gen"
      ],
      "conformanceCases": 211
    },
    "extension": {
      "languages": [
        "php-extension"
      ],
      "compileModes": [
        "ast"
      ]
    },
    "browser": {
      "languages": [
        "javascript-esm"
      ],
      "source": "typescript",
      "compileModes": [
        "ast",
        "gen"
      ]
    }
  },
  "types": {
    "CompileMode": {
      "variants": [
        "ast",
        "gen"
      ],
      "invariant": "Selects the compiled program representation only."
    },
    "ArtifactRefresh": {
      "variants": [
        "dev",
        "true",
        "false"
      ],
      "invariant": "Controls build artifact regeneration independently of compile mode."
    },
    "SourceGraph": {
      "fields": [
        "entry",
        "templates"
      ],
      "invariant": "Contains normalized UTF-8 sources before parsing and is never read by a deployed false-refresh program."
    },
    "TypeManifest": {
      "fields": [
        "entry",
        "fields",
        "records",
        "functions",
        "defines",
        "templates"
      ],
      "invariant": "Types, host function signatures and fixed definition targets are explicit compiler inputs."
    },
    "TypedProgram": {
      "fields": [
        "entry",
        "fields",
        "records",
        "functions",
        "definitions",
        "templates"
      ],
      "invariant": "All symbols, paths, expression types, function calls and block inputs are resolved before artifact emission."
    },
    "ArtifactManifest": {
      "fields": [
        "schema",
        "mode",
        "target",
        "entry",
        "sourceDigest",
        "typeDigest",
        "contractDigest",
        "files"
      ],
      "invariant": "Digests bind the artifact to its complete sources, types and compiler contract."
    },
    "RenderRequest": {
      "fields": [
        "target",
        "assign",
        "define",
        "env"
      ],
      "invariant": "assign is root data and define is the template registry; both modes receive the same normalized values."
    },
    "Program": {
      "operations": [
        "prepare",
        "render"
      ],
      "invariant": "AstProgram and GeneratedProgram are disjoint peer implementations with identical observable behavior."
    },
    "AstProgram": {
      "fields": [
        "artifact",
        "runtimeBindings"
      ],
      "operation": "Interpret a precompiled canonical AST without parsing during render."
    },
    "GeneratedProgram": {
      "fields": [
        "artifact",
        "runtimeBindings"
      ],
      "operation": "Call generated template functions directly without retaining a parser or AST interpreter."
    },
    "RuntimeBindings": {
      "operations": [
        "truthy",
        "stringify",
        "escape",
        "number",
        "finite",
        "equal",
        "compare",
        "member",
        "index",
        "entries",
        "call",
        "limit",
        "error"
      ],
      "invariant": "AST evaluation and generated code share the same language-specific value and error semantics."
    },
    "FunctionSignature": {
      "fields": [
        "implementation",
        "args",
        "returns"
      ],
      "invariant": "Built-in and host signatures are checked before artifact emission; implementations are resolved at program load."
    },
    "DefinitionData<T>": {
      "fields": "one presence-preserving optional field for every Input<T> field",
      "invariant": "An absent field does not overwrite assign; a present nullable field carries null."
    },
    "Definition<T>": {
      "fields": [
        "html",
        "data"
      ],
      "invariant": "html bypasses template execution; data has the fixed DefinitionData<T> type of the declared target."
    },
    "Definitions": {
      "fields": "one optional Definition<T> field for every declared define key",
      "invariant": "Generated code cannot select a target absent from the manifest."
    },
    "Input<T>": {
      "fields": "the fields declared for template T",
      "invariant": "Block input precedence is assign, definition.data, then block scope."
    },
    "RuntimeServices": {
      "operations": [
        "limits",
        "hostFunction"
      ],
      "invariant": "AST and generated programs expose the same resource limits and host function lookup without coupling render state to an AST loader."
    },
    "RenderFrame": {
      "fields": [
        "name",
        "lines",
        "context"
      ],
      "invariant": "Carries only runtime location and context data; it never owns a canonical AST."
    },
    "RenderScope": {
      "fields": [
        "locals",
        "loops"
      ],
      "operations": [
        "lookup",
        "loopMeta"
      ],
      "invariant": "Includes share one scope and blocks create a new scope in both compiler modes."
    }
  },
  "components": {
    "Compiler": {
      "owns": [
        "sourceGraph",
        "typeManifest",
        "typedProgram"
      ],
      "operations": [
        "loadSourceGraph",
        "parseSourceGraph",
        "lowerSourceGraph",
        "emitArtifact"
      ]
    },
    "LanguageBackend": {
      "owns": [
        "target"
      ],
      "operations": [
        "emitDeclarations",
        "emitRuntime",
        "emitTemplates",
        "emitEntry"
      ]
    },
    "ArtifactStore": {
      "owns": [
        "artifactManifest",
        "files"
      ],
      "operations": [
        "load",
        "regenerate",
        "loadOrRefresh"
      ]
    },
    "Engine": {
      "owns": [
        "program"
      ],
      "operations": [
        "prepare",
        "render"
      ]
    },
    "PageCache": {
      "owns": [
        "html",
        "ttl"
      ],
      "operations": [
        "get",
        "put",
        "getOrSet"
      ]
    },
    "RuntimeServices": {
      "owns": [
        "limits",
        "hostFunctions"
      ],
      "operations": [
        "limits",
        "hostFunction"
      ]
    }
  },
  "runtimeContract": {
    "Program": {
      "kind": "interface",
      "operations": [
        {
          "name": "prepare",
          "parameters": [
            "target",
            "assign",
            "options"
          ],
          "returns": "PreparedRender or error"
        },
        {
          "name": "render",
          "parameters": [
            "target",
            "assign",
            "options"
          ],
          "returns": "UTF-8 string or error"
        }
      ]
    },
    "Engine": {
      "kind": "concrete",
      "owns": [
        "program"
      ],
      "implements": "Program",
      "operations": [
        "prepare",
        "render"
      ]
    },
    "AstProgram": {
      "kind": "concrete",
      "implements": "Program"
    },
    "GeneratedProgram": {
      "kind": "generated-concrete",
      "implements": "Program"
    },
    "RuntimeBindings": {
      "kind": "concrete",
      "operations": [
        {
          "name": "truthy",
          "parameters": [
            "value"
          ],
          "returns": "bool"
        },
        {
          "name": "stringify",
          "parameters": [
            "value",
            "frame",
            "span"
          ],
          "returns": "string or error"
        },
        {
          "name": "escape",
          "parameters": [
            "value",
            "frame",
            "span"
          ],
          "returns": "string or error"
        },
        {
          "name": "number",
          "parameters": [
            "value",
            "frame",
            "span"
          ],
          "returns": "number or error"
        },
        {
          "name": "finite",
          "parameters": [
            "number",
            "frame",
            "span"
          ],
          "returns": "number or error"
        },
        {
          "name": "equal",
          "parameters": [
            "left",
            "right",
            "strict"
          ],
          "returns": "bool"
        },
        {
          "name": "compare",
          "parameters": [
            "left",
            "right",
            "frame",
            "span"
          ],
          "returns": "ordering or error"
        },
        {
          "name": "member",
          "parameters": [
            "container",
            "key"
          ],
          "returns": "value"
        },
        {
          "name": "index",
          "parameters": [
            "container",
            "key"
          ],
          "returns": "value"
        },
        {
          "name": "entries",
          "parameters": [
            "value",
            "frame",
            "span"
          ],
          "returns": "entries or error"
        },
        {
          "name": "call",
          "parameters": [
            "name",
            "args",
            "frame",
            "span"
          ],
          "returns": "value or error"
        },
        {
          "name": "limit",
          "parameters": [
            "kind",
            "count",
            "frame",
            "span"
          ],
          "returns": "void or error"
        },
        {
          "name": "error",
          "parameters": [
            "frame",
            "span",
            "code",
            "message"
          ],
          "returns": "error"
        }
      ]
    },
    "RuntimeServices": {
      "kind": "interface",
      "operations": [
        {
          "name": "limits",
          "parameters": [],
          "returns": "Limits"
        },
        {
          "name": "hostFunction",
          "parameters": [
            "name"
          ],
          "returns": "HostFunction or missing"
        }
      ]
    },
    "RenderFrame": {
      "kind": "concrete",
      "fields": [
        "name",
        "lines",
        "context"
      ],
      "operations": []
    },
    "RenderScope": {
      "kind": "concrete",
      "fields": [
        "locals",
        "loops"
      ],
      "operations": [
        "lookup",
        "loopMeta"
      ]
    }
  },
  "operations": [
    {
      "name": "loadSourceGraph",
      "owner": "Compiler",
      "parameters": [
        "source manifest"
      ],
      "returns": "SourceGraph"
    },
    {
      "name": "parseSourceGraph",
      "owner": "Compiler",
