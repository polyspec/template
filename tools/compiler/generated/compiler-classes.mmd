classDiagram
  class Compiler {
    +loadSourceGraph(source graph manifest) SourceGraph
    +lowerSourceGraph(SourceGraph, TypeManifest) TypedProgram
  }
  class LanguageBackend {
    +emit(TypedProgram) GeneratedModule source
  }
  class GeneratedModule {
    +renderTemplate(target, Assign, Definitions) UTF-8 string
    +render(Assign, Definitions) UTF-8 string
  }
  class SourceGraph {
    +entry
    +templates
  }
  class TypeManifest {
    +entry
    +fields
    +records
    +functions
    +defines
    +templates
  }
  class TypedProgram {
    +entry
    +fields
    +records
    +functions
    +definitions
    +templates
  }
  class Definition~T~ {
    +html
    +data
  }
  class DefinitionData~T~
  class Definitions
  class Input~T~
  class FunctionSignature {
    +implementation
    +args
    +returns
  }
  SourceGraph --> Compiler : input
  TypeManifest --> Compiler : input
  Compiler --> TypedProgram : output
  TypedProgram --> LanguageBackend : input
  LanguageBackend --> GeneratedModule : source
  GeneratedModule --> Definitions
  Definitions --> Definition~T~
  Definition~T~ --> DefinitionData~T~ : data
  DefinitionData~T~ --> Input~T~ : field types
  TypeManifest --> FunctionSignature : functions
