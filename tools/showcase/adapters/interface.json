{
  "schema": 3,
  "name": "RenderAdapter",
  "concreteType": "Adapter",
  "supportLevels": {
    "core-runtime": {
      "description": "Renders an already loaded template with assign and define data.",
      "operations": [
        "render"
      ]
    },
    "source-compiler": {
      "description": "Parses source templates and produces the canonical AST artifact.",
      "operations": [
        "parse",
        "encodeArtifact"
      ]
    },
    "artifact-runtime": {
      "description": "Loads canonical AST artifacts without parsing source templates.",
      "operations": [
        "loadArtifact",
        "render"
      ]
    },
    "native-source-backend": {
      "description": "Optional backend that emits executable source for one host language.",
      "operations": [
        "compileNative",
        "loadNative"
      ]
    }
  },
  "executionModes": {
    "ast": {
      "description": "Load the canonical AST artifact once and interpret it for each render.",
      "input": "canonical AST artifact",
      "requestPath": [
        "loadArtifact",
        "bind assign and define",
        "render AST"
      ],
      "requiredSupportLevel": "artifact-runtime",
      "status": "implemented"
    },
    "generated": {
      "description": "Lower canonical AST nodes into executable host-language renderer source before startup and call it at runtime.",
      "input": "generated host-language source",
      "requestPath": [
        "lower AST nodes",
        "compileNative",
        "loadNative",
        "bind assign and define",
        "call generated renderer"
      ],
      "requiredSupportLevel": "native-source-backend",
      "status": "implemented"
    }
  },
  "artifactRefresh": {
    "dev": "Refresh the selected compiled artifact on every call.",
    "true": "Reuse the artifact until its source version changes.",
    "false": "Use the deployed artifact without runtime refresh."
  },
  "pageCache": {
    "ttl": "Positive seconds expire; 0 and null mean forever.",
    "hit": "Returns final HTML before business logic and template rendering."
  },
  "constructor": {
    "parameters": [
      {
        "name": "root",
        "type": "path",
        "mode": "owned"
      }
    ],
    "returns": "Adapter",
    "errors": [
      "ContractError"
    ],
    "preconditions": [
      "root contains scenario.json",
      "scenario.json is valid JSON"
    ],
    "reads": [
      "scenario.json.legacyWrappers"
    ],
    "mutates": [
      "Adapter.engine configuration"
    ],
    "owns": [
      "Adapter.root",
      "Adapter.engine"
    ]
  },
  "types": {
    "JsonValue": {
      "kind": "recursive-union",
      "variants": [
        "null",
        "boolean",
        "number",
        "string",
        "array<JsonValue>",
        "ordered-object<string, JsonValue>"
      ]
    },
    "JsonObject": {
      "kind": "alias",
      "type": "ordered-object<string, JsonValue>"
    },
    "DefineRegistry": {
      "kind": "alias",
      "type": "ordered-map<string, string | DefineEntry>",
      "invariant": "a string is the canonical template path; DefineEntry is reserved for template data or an HTML slot"
    },
    "DefineEntry": {
      "kind": "union",
      "order": [
        "template",
        "html"
      ],
      "variants": [
        {
          "name": "template",
          "fields": [
            {
              "name": "template",
              "type": "string",
              "nullable": false,
              "required": true,
              "order": 1
            },
            {
              "name": "data",
              "type": "JsonObject",
              "nullable": false,
              "required": false,
              "order": 2
            }
          ],
          "owns": [
            "template",
            "data"
          ]
        },
        {
          "name": "html",
          "fields": [
            {
              "name": "html",
              "type": "string",
              "nullable": false,
              "required": true,
              "order": 1
            }
          ],
          "owns": [
            "html"
          ]
        }
      ],
      "invariant": "exactly one variant is present; html cannot carry data"
    },
    "Environment": {
      "kind": "record",
      "fields": [
        {
          "name": "timezone",
          "type": "string",
          "nullable": false,
          "required": false,
          "order": 1
        },
        {
          "name": "now",
          "type": "number",
          "nullable": false,
          "required": false,
          "order": 2
        }
      ],
      "invariant": "omitted values use the engine defaults"
    },
    "Scenario": {
      "kind": "record",
      "fields": [
        {
          "name": "target",
          "type": "string",
          "nullable": false,
          "required": true,
          "order": 1,
          "owns": "Scenario.target"
        },
        {
          "name": "assign",
          "type": "JsonObject",
          "nullable": false,
          "required": true,
          "order": 2,
          "owns": "Scenario.assign"
        },
        {
          "name": "define",
          "type": "DefineRegistry",
          "nullable": false,
          "required": true,
          "order": 3,
          "owns": "Scenario.define"
        },
        {
          "name": "env",
          "type": "Environment",
          "nullable": false,
          "required": false,
          "order": 4,
          "owns": "Scenario.env"
        }
      ],
      "invariant": "assign and define are decoded from the scenario files without renaming or reshaping"
    },
    "RenderRequest": {
      "kind": "record",
      "fields": [
        {
          "name": "target",
          "type": "string",
          "nullable": false,
          "required": true,
          "order": 1,
          "from": "Scenario.target"
        },
        {
          "name": "assign",
          "type": "JsonObject",
          "nullable": false,
          "required": true,
          "order": 2,
          "from": "Scenario.assign"
        },
        {
          "name": "define",
          "type": "DefineRegistry",
          "nullable": false,
          "required": true,
          "order": 3,
          "from": "Scenario.define"
        },
        {
          "name": "env",
          "type": "Environment",
          "nullable": false,
          "required": false,
          "order": 4,
          "from": "Scenario.env"
        }
      ],
      "invariant": "render reads the request and leaves every field unchanged"
    },
    "RepeatResult": {
      "kind": "record",
      "fields": [
        {
          "name": "first",
          "type": "string",
          "nullable": false,
          "required": true,
          "order": 1
        },
        {
          "name": "second",
          "type": "string",
          "nullable": false,
          "required": true,
          "order": 2
        }
      ],
      "invariant": "first and second must have identical UTF-8 bytes"
    }
  },
  "operations": [
    {
      "name": "loadScenario",
      "parameters": [],
      "returns": "Scenario",
      "errors": [
        "ContractError"
      ],
      "preconditions": [
        "Adapter.root exists",
        "scenario.json, data.json and define.json are readable"
      ],
      "mutates": [],
      "calls": [],
      "failureState": "Adapter remains ready"
    },
    {
      "name": "buildRequest",
      "parameters": [
        {
          "name": "scenario",
          "type": "Scenario",
          "mode": "read-only"
        }
      ],
      "returns": "RenderRequest",
      "errors": [
        "ContractError"
      ],
      "preconditions": [
        "scenario.target is a non-empty string",
        "scenario.assign is an object",
        "scenario.define is an ordered map"
      ],
      "mutates": [],
      "calls": [],
      "failureState": "Adapter remains ready; scenario remains unchanged"
    },
    {
      "name": "render",
      "parameters": [
        {
          "name": "request",
          "type": "RenderRequest",
          "mode": "read-only"
        }
      ],
      "returns": "string",
      "errors": [
        "RenderError"
      ],
      "preconditions": [
        "request.target is a loader name or a registered template target"
      ],
      "mutates": [
        "Adapter.engine cache only"
      ],
      "calls": [
        "Engine.render(request.target, request.assign, request.define, request.env)"
      ],
      "failureState": "Adapter.engine output is discarded; request remains unchanged"
    },
    {
      "name": "renderTwice",
      "parameters": [
        {
          "name": "request",
          "type": "RenderRequest",
          "mode": "read-only"
        }
      ],
      "returns": "RepeatResult",
      "errors": [
        "RenderError"
      ],
      "preconditions": [
        "request satisfies render preconditions"
      ],
      "mutates": [
        "Adapter.engine cache only"
      ],
      "calls": [
        "render(request)",
        "render(request)"
      ],
      "failureState": "Adapter remains usable; request remains unchanged"
    }
  ],
  "state": {
    "states": [
      "ready",
      "scenario-loaded",
      "request-built",
      "rendered",
      "failed"
    ],
    "transitions": [
      {
        "operation": "constructor",
        "from": "new",
        "to": "ready",
        "onError": "no Adapter value is returned"
      },
      {
        "operation": "loadScenario",
        "from": "ready",
        "to": "scenario-loaded",
        "onError": "ready"
      },
      {
        "operation": "buildRequest",
        "from": "scenario-loaded",
        "to": "request-built",
        "onError": "ready"
      },
      {
        "operation": "render",
        "from": "request-built",
        "to": "rendered",
        "onError": "failed -> request-built"
      },
      {
        "operation": "renderTwice",
        "from": "request-built",
        "to": "rendered",
        "onError": "failed -> request-built"
      }
    ]
  },
  "languages": {
    "typescript": {
      "supportLevels": [
        "core-runtime",
        "source-compiler",
        "artifact-runtime",
        "native-source-backend"
      ],
      "file": "typescript.ts",
      "generated": "generated/render_adapter.ts",
      "type": "Adapter",
      "constructorName": "constructor",
      "operationNames": {
        "loadScenario": "loadScenario",
        "buildRequest": "buildRequest",
        "render": "render",
        "renderTwice": "renderTwice"
      },
      "checker": "tsc"
    },
    "javascript": {
      "supportLevels": [
        "core-runtime",
        "source-compiler",
        "artifact-runtime",
        "native-source-backend"
      ],
      "file": "javascript.mjs",
      "generated": "generated/render_adapter.mjs",
      "type": "Adapter",
      "constructorName": "constructor",
      "operationNames": {
        "loadScenario": "loadScenario",
        "buildRequest": "buildRequest",
        "render": "render",
        "renderTwice": "renderTwice"
      },
      "checker": "runtime"
    },
    "go": {
      "supportLevels": [
        "core-runtime",
        "source-compiler",
        "artifact-runtime",
        "native-source-backend"
      ],
      "file": "go/main.go",
      "generated": "go/render_adapter.go",
      "type": "Adapter",
      "constructorName": "NewAdapter",
      "operationNames": {
        "loadScenario": "LoadScenario",
        "buildRequest": "BuildRequest",
        "render": "Render",
        "renderTwice": "RenderTwice"
      },
      "checker": "go build"
    },
    "rust": {
      "supportLevels": [
        "core-runtime",
        "source-compiler",
        "artifact-runtime",
        "native-source-backend"
      ],
      "file": "rust/src/main.rs",
      "generated": "rust/src/render_adapter.rs",
      "type": "Adapter",
      "constructorName": "new",
      "operationNames": {
        "loadScenario": "load_scenario",
        "buildRequest": "build_request",
        "render": "render",
        "renderTwice": "render_twice"
      },
      "checker": "cargo check"
    },
    "php": {
      "supportLevels": [
        "core-runtime",
        "source-compiler",
        "artifact-runtime",
        "native-source-backend"
      ],
      "file": "php.php",
      "generated": "generated/render_adapter.php",
      "type": "Adapter",
      "constructorName": "__construct",
      "operationNames": {
        "loadScenario": "loadScenario",
        "buildRequest": "buildRequest",
        "render": "render",
        "renderTwice": "renderTwice"
      },
      "checker": "ReflectionClass"
    }
  }
}
