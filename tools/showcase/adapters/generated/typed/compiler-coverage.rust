// Generated.
#[derive(Clone, Default)] pub struct Page { pub title: String }
#[derive(Clone, Default)] pub struct Row { pub name: String }
#[derive(Clone, Default)] pub struct Slot { pub template: Option<String>, pub html: Option<String> }
#[derive(Clone, Default)] pub struct Assign {
    pub flag: bool,
    pub dangerous: String,
    pub empty_list: Vec<String>,
    pub empty_map: OrderedMap<String, String>,
    pub page: Page,
    pub numbers: Vec<f64>,
    pub lookup: OrderedMap<String, String>,
    pub rows: Vec<Row>,
}
#[derive(Clone, Default)] pub struct Input_card_tpl { pub label: String }
#[derive(Clone, Default)] pub struct Input_layout_tpl {  }
#[derive(Clone, Default)] pub struct Input_partial_tpl { pub values: Vec<f64> }
#[derive(Clone, Default)] pub struct DefinitionData_card_tpl { pub label: Option<String> }
#[derive(Clone, Default)] pub struct DefinitionData_layout_tpl {  }
#[derive(Clone, Default)] pub struct DefinitionData_partial_tpl { pub values: Option<Vec<f64>> }
#[derive(Clone)] pub struct Definition<T> { pub html: Option<String>, pub data: Option<T> }
#[derive(Clone, Default)] pub struct Definitions { pub content: Option<Definition<DefinitionData_card_tpl>>, pub layout: Option<Definition<DefinitionData_layout_tpl>> }
#[derive(Clone, Default)] enum GeneratedValue { #[default] Null }
#[derive(Clone)] struct OrderedEntry<K, V> { key: K, value: V }
#[derive(Clone, Default)] struct OrderedMap<K, V> { entries: Vec<OrderedEntry<K, V>> }
impl<K: PartialEq, V> OrderedMap<K, V> { fn new() -> Self { Self { entries: Vec::new() } } fn set(&mut self, key: K, value: V) { if let Some(entry) = self.entries.iter_mut().find(|entry| entry.key == key) { entry.value = value; } else { self.entries.push(OrderedEntry { key, value }); } } fn get(&self, key: &K) -> Option<&V> { self.entries.iter().find(|entry| &entry.key == key).map(|entry| &entry.value) } fn entries(&self) -> &Vec<OrderedEntry<K, V>> { &self.entries } }
trait GeneratedTruthy { fn generated_truthy(&self) -> bool; }
impl GeneratedTruthy for bool { fn generated_truthy(&self) -> bool { *self } }
impl GeneratedTruthy for f64 { fn generated_truthy(&self) -> bool { *self != 0.0 } }
impl GeneratedTruthy for String { fn generated_truthy(&self) -> bool { !self.is_empty() } }
impl<T> GeneratedTruthy for Vec<T> { fn generated_truthy(&self) -> bool { !self.is_empty() } }
impl<K, V> GeneratedTruthy for OrderedMap<K, V> { fn generated_truthy(&self) -> bool { !self.entries.is_empty() } }
impl<T: GeneratedTruthy> GeneratedTruthy for Option<T> { fn generated_truthy(&self) -> bool { self.as_ref().is_some_and(GeneratedTruthy::generated_truthy) } }
fn generated_truthy<T: GeneratedTruthy>(value: &T) -> bool { value.generated_truthy() }
trait GeneratedContains<T> { fn generated_contains(&self, value: &T) -> bool; }
impl<T: PartialEq> GeneratedContains<T> for Vec<T> { fn generated_contains(&self, value: &T) -> bool { self.contains(value) } }
impl<K: PartialEq, V> GeneratedContains<K> for OrderedMap<K, V> { fn generated_contains(&self, value: &K) -> bool { self.get(value).is_some() } }
impl GeneratedContains<String> for String { fn generated_contains(&self, value: &String) -> bool { self.contains(value) } }
fn generated_in<T, C: GeneratedContains<T>>(value: &T, collection: &C) -> bool { collection.generated_contains(value) }
fn escape(value: &str) -> String { value.replace('&', "&amp;").replace('<', "&lt;").replace('>', "&gt;").replace('"', "&quot;").replace('\'', "&#39;") }
fn render_card_tpl(assign: &Assign, definitions: &Definitions, input: Input_card_tpl) -> String { let mut out = String::new();
let label = input.label;
    out.push_str("<p class=\"card\">");
    out.push_str(&escape(&label.to_string()));
    out.push_str("</p>\n");
 out }
fn render_layout_tpl(assign: &Assign, definitions: &Definitions, input: Input_layout_tpl) -> String { let mut out = String::new();

    let values = { let mut result: Vec<f64> = Vec::new(); result.push(0f64); result.extend(assign.numbers.clone()); result };
    let merged = { let mut result: OrderedMap<String, String> = OrderedMap::new(); for entry in assign.lookup.clone().entries() { result.set(entry.key.clone(), entry.value.clone()); } result.set("z".to_string(), "Z".to_string()); result };
    out.push_str("<section>\n<h1>");
    out.push_str(&escape(&assign.page.clone().title.to_string()));
    out.push_str("</h1>\n<p class=\"escaped\">");
    out.push_str(&escape(&assign.dangerous.clone().to_string()));
    out.push_str("</p>\n<p class=\"logical\">");
    out.push_str(&escape(&(generated_truthy(&assign.flag.clone()) && generated_truthy(&"x".to_string())).to_string()));
    out.push_str("|");
    out.push_str(&escape(&(generated_truthy(&false) || generated_truthy(&2f64)).to_string()));
    out.push_str("</p>\n<p class=\"empty-truthiness\">");
    out.push_str(&escape(&(generated_truthy(&assign.empty_list.clone()) && generated_truthy(&assign.flag.clone())).to_string()));
    out.push_str("|");
    out.push_str(&escape(&(generated_truthy(&assign.empty_map.clone()) && generated_truthy(&assign.flag.clone())).to_string()));
    out.push_str("</p>\n<p>");
    out.push_str(&escape(&values.get(1f64 as usize).cloned().unwrap_or_default().to_string()));
    out.push_str("|");
    out.push_str(&escape(&merged.get(&"z".to_string()).cloned().unwrap_or_default().to_string()));
    out.push_str("</p>\n");
    if generated_truthy(&(generated_truthy(&assign.flag.clone()) && generated_truthy(&(assign.page.clone().title == "Guide".to_string())))) {
        out.push_str("<strong>matched</strong>");    } else {
        out.push_str("<strong>missed</strong>");
    }
    out.push_str("\n<p>");
    out.push_str(&escape(&if generated_truthy(&assign.flag.clone()) { "yes".to_string() } else { "no".to_string() }.to_string()));
    out.push_str("|");
    out.push_str(&escape(&((-1f64) + 3f64).to_string()));
    out.push_str("|");
    out.push_str(&escape(&{ let value = "".to_string(); if generated_truthy(&value) { value } else { "fallback".to_string() } }.to_string()));
    out.push_str("</p>\n<ul>\n");
    { let entries = assign.rows.clone().iter().cloned().enumerate().map(|(key, value)| (key as f64, value)).collect::<Vec<_>>();
    for (row_index_raw, (row_key, row_value)) in entries.iter().cloned().enumerate() {
        let row = row_value.clone();
        let row_index = row_index_raw as f64;
        let row_size = entries.len() as f64;
        let row_first = row_index_raw == 0;
        let row_last = row_index_raw + 1 == entries.len();
            out.push_str("<li>");
            out.push_str(&escape(&row_index.clone().to_string()));
            out.push_str("/");
            out.push_str(&escape(&row_size.clone().to_string()));
            out.push_str(":");
            out.push_str(&escape(&row.name.to_string()));
            out.push_str(":");
            out.push_str(&escape(&row_first.clone().to_string()));
            out.push_str(":");
            out.push_str(&escape(&row_last.clone().to_string()));
            out.push_str("</li>\n");
    }
    if entries.is_empty() {
            out.push_str("<li>empty</li>\n");
    }
    }
    out.push_str("</ul>\n");
    out.push_str(&render_partial_tpl(assign, definitions, Input_partial_tpl { values: values }));
    if definitions.content.is_some() {
            out.push_str("<p>defined</p>");
    } else {
            out.push_str("<p>missing</p>");
    }
    out.push_str("\n");
    { let definition = definitions.content.as_ref();
    if definition.is_none() { panic!("generated definition content is missing"); }
    if let Some(html) = definition.and_then(|value| value.html.as_ref()) { out.push_str(html); } else {
        let mut input = Input_card_tpl::default();

        if let Some(data) = definition.and_then(|value| value.data.as_ref()) {
            if let Some(value) = data.label.clone() { input.label = value; }
        }
        input.label = assign.page.clone().title;
        out.push_str(&render_card_tpl(assign, definitions, input));
    }
    }
    out.push_str("</section>\n");
 out }
fn render_partial_tpl(assign: &Assign, definitions: &Definitions, input: Input_partial_tpl) -> String { let mut out = String::new();
let values = input.values;
    out.push_str("<p class=\"included\">");
    out.push_str(&escape(&values.get(2f64 as usize).cloned().unwrap_or_default().to_string()));
    out.push_str("</p>\n");
 out }
pub fn render_template(target: &str, assign: &Assign, definitions: &Definitions) -> String { match target {
        "layout.tpl" => render_layout_tpl(assign, definitions, Input_layout_tpl::default()),
        _ => panic!("generated template is missing or requires inputs: {target}"),
} }
pub fn render(assign: &Assign, definitions: &Definitions) -> String { render_template("layout.tpl", assign, definitions) }
