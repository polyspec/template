fn escape(value: &str) -> String { value.replace('&', "&amp;").replace('<', "&lt;").replace('>', "&gt;").replace('"', "&quot;").replace('\'', "&#39;") }
fn render_layout_tpl(assign: &Assign, definitions: &Definitions, input: Input_layout_tpl) -> String { let mut out = String::new();

    out.push_str("<main class=\"empty-page\">\n");
    if definitions.content.is_some() {
            { let definition = definitions.content.as_ref();
            let html = definition.and_then(|value| value.html.as_ref()).expect("generated definition content requires html");
            out.push_str(html);
            }
    } else {
            out.push_str("<p class=\"empty\">No content definition.</p>\n");
    }
    out.push_str("</main>\n");
 out }
