{
    "name": "polyspec/template-cli",
    "description": "Command line of the template language on the PHP library: an application, not a library (K433)",
    "version": "0.0.14",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "polyspec/template": "0.0.14",
        "symfony/console": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.5"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Template\\Cli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Template\\Cli\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/template.php"
    ],
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true
    }
}
