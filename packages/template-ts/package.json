{
  "name": "@polyspec/template",
  "version": "0.0.1",
  "description": "Template language implementation: lexer, parser, renderer, functions and CLI",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.mjs",
      "require": "./dist/render.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.cjs"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "template": "./bin/template.mjs"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsup": "^8.5.0",
    "vitest": "^5.0.0"
  }
}
