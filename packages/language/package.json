{
  "name": "@polyspec/template-language",
  "version": "0.0.15",
  "description": "Formatter, command line tool and tag structure analysis for template sources; formatting changes whitespace inside tags and the indentation of lines",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "template-fmt": "./bin/template-fmt.mjs",
    "template-language": "./bin/template-language.mjs"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=26.12.0"
  },
  "dependencies": {
    "@polyspec/template": "0.0.15"
  }
}
