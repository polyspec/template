{
  "name": "polyspec-template",
  "displayName": "Polyspec Template",
  "description": "Syntax highlighting with embedded HTML, CSS and JavaScript and a client of the bundled template language server: parse diagnostics, semantic tokens, matching tags, folding, formatting and typing indentation for the polyspec template language",
  "version": "0.0.5",
  "publisher": "polyspec",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/polyspec/template",
    "directory": "packages/template-vscode"
  },
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "polyspec-template",
        "aliases": [
          "Polyspec Template",
          "polyspec-template"
        ],
        "extensions": [
          ".tpl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "polyspec-template",
        "scopeName": "text.html.polyspec-template",
        "path": "./syntaxes/polyspec-template.tmLanguage.json",
        "embeddedLanguages": {
          "source.css": "css",
          "source.js": "javascript"
        }
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "delimiter",
        "superType": "keyword",
        "description": "Open and close delimiter of a template tag"
      },
      {
        "id": "path",
        "superType": "string",
        "description": "Unquoted include path or word of a block tag body"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "polyspec-template",
        "scopes": {
          "delimiter": [
            "keyword.control.tag.begin.polyspec-template"
          ],
          "keyword": [
            "keyword.control.polyspec-template"
          ],
          "path": [
            "string.unquoted.path.polyspec-template"
          ]
        }
      }
    ],
    "configuration": {
      "title": "Polyspec Template",
      "properties": {
        "polyspec-template.format.templateBlocks": {
          "type": "string",
          "enum": [
            "indent",
            "flat"
          ],
          "enumDescriptions": [
            "Template blocks add an indentation level like HTML elements.",
            "Template blocks add no indentation level; their lines get the depth of the HTML elements."
          ],
          "default": "indent",
          "scope": "resource",
          "description": "How the formatter indents the lines inside template blocks ({? }, {@ }, {?# })."
        }
      }
    },
    "configurationDefaults": {
      "[polyspec-template]": {
        "editor.formatOnType": true
      }
    },
    "commands": [
      {
        "command": "polyspec-template.goToMatchingTag",
        "title": "Go to Matching Template Tag",
        "category": "Polyspec Template"
      }
    ],
    "keybindings": [
      {
        "command": "polyspec-template.goToMatchingTag",
        "key": "ctrl+alt+\\",
        "mac": "cmd+alt+\\",
        "when": "editorTextFocus && editorLangId == polyspec-template"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "polyspec-template.goToMatchingTag",
          "when": "editorLangId == polyspec-template"
        }
      ]
    }
  },
  "dependencies": {
    "@polyspec/template-lsp": "0.0.5",
    "vscode-languageclient": "^10.1.2"
  }
}
