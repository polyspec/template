{
    "name": "polyspec/template",
    "version": "0.0.6",
    "description": "Template language implementation: lexer, parser, renderer, functions and CLI",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "symfony/console": "^8.1"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Template\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Template\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/template.php"],
    "config": {
        "platform": {
            "php": "8.5.0"
        },
        "sort-packages": true
    }
}
