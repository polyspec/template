{
    "name": "polyspec/template",
    "version": "0.0.13",
    "description": "Template language implementation: lexer, parser, renderer, functions and CLI",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "opis/json-schema": "^2.6"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Template\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Template\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true
    }
}
