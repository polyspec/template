{
  "name": "@polyspec/template",
  "version": "0.0.32",
  "description": "The template library of polyspec for Node and the browser",
  "license": "MIT",
  "type": "module",
  "main": "./generated/index.cjs",
  "types": "./generated/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./wasm/generated/index.d.ts",
        "default": "./wasm/generated/index.mjs"
      },
      "types": "./generated/index.d.ts",
      "import": "./generated/index.mjs",
      "require": "./generated/index.cjs"
    },
    "./wasm": {
      "types": "./wasm/generated/index.d.ts",
      "default": "./wasm/generated/index.mjs"
    },
    "./render": {
      "types": "./render/render.d.ts",
      "import": "./render/render.mjs",
      "require": "./render/render.cjs"
    },
    "./decode": {
      "types": "./render/decode.d.ts",
      "import": "./render/decode.mjs",
      "require": "./render/decode.cjs"
    }
  },
  "files": [
    "generated/index.cjs",
    "generated/index.mjs",
    "generated/index.d.ts",
    "wasm/generated/*.mjs",
    "wasm/generated/*.js",
    "wasm/generated/*.d.ts",
    "wasm/generated/*.wasm",
    "render"
  ],
  "napi": {
    "binaryName": "template",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  },
  "dependencies": {
    "@polyspec/json": "https://github.com/polyspec/json/releases/download/v0.0.40/polyspec-json-0.0.40.tgz"
  }
}
