{
    "name": "polyspec/template",
    "description": "Template language implementation: lexer, parser, renderer, functions and CLI",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Template\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Template\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/template.php"],
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test"
    },
    "config": {
        "sort-packages": true
    }
}
