  "formatted": "{* The posts of the board, newest first *}\n{:t = messages.board}\n<div class=\"board-list\">\n  <h2>{= t[\"list.heading\"]}</h2>\n  {? length(posts) == 0}\n    <p>{= t[\"list.empty\"]}</p>\n  {:? filter}\n    <p class=\"filtered\">{= filter | escape}</p>\n  {:}\n    <ul>\n      {@ post = posts}\n        <li><a href=\"{= post.href}\"{? post.id == highlight} class=\"new\"{/}>{= post.title}</a></li>\n      {/}\n    </ul>\n  {/}\n  {+ parts/pager.tpl}\n</div>\n"
