{
  "name": "@polyspec/template-lsp",
  "version": "0.0.4",
  "description": "Language Server Protocol server for template sources over standard input and output: diagnostics, semantic tokens, folding, matching tags, formatting and typing indentation from @polyspec/template-language",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./server": "./dist/main.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "template-lsp": "./bin/template-lsp.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@polyspec/template-language": "0.0.4",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  }
}
