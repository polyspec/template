// The Go backend. It writes the canonical form of gofmt itself (T25.1): tabs, one statement per line, a blank line
// between top-level declarations, the fields of a struct aligned in columns and the imports sorted by path, and it
// writes only the helpers, imports and types that the program uses (definitions of backend-support.mts). A function
// literal in an expression starts on the line of its expression and indents its body one level deeper than that line;
// every function here returns code whose first line starts at level 0, and `tabs` places it at its level.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import {
  assignedNames, baseTarget, definition, definitionDataName, descriptor, emitExpression, emitNodes, exportedName,
  fieldName, FunctionLocals, functionName, goString, goType, inputName, typeKey,
  type BackendContext, type Descriptor, type MergedLocal, type Part, type Target,
} from '../backend-support.mts';
import type { Span } from '@polyspec/template';
import { loweredTemplate, type Definition, type Expr, type LoweredTemplate, type Node, type NodeOf, type Program, type ValueType } from '../ir.mts';
import { packageRoot } from '../package-root.mts';

export const language = 'go';

// The header of generated Go, by the convention that Go tools honor (`go help generate`).
export const GO_HEADER = '// Code generated by @polyspec/template-compiler. DO NOT EDIT.';

/**
 * The Go that the program holds as it is, from `<file>.go` in backends/go, where gofmt and go vet check it (make
 * lint-go-format, make template-test-go-backend-vet): the declarations after its package clause and imports, which
 * emitDeclarations writes for the whole program, without the final newline of the file.
 */
function goSource(file: string): string {
  const text = readFileSync(join(packageRoot, 'backends/go', `${file}.go`), 'utf8');
  return text.slice(text.search(/^(?:func|type) /m), -1);
}

/** The Go literal of the type of a request value that generatedCheck checks it against (generated_check.go, T24.33). */
function goCheckType(type: Descriptor): string {
  const fields = [`Kind: ${goString(type.kind)}`];
  if (type.optional) fields.push('Optional: true');
  if (type.kind === 'record') fields.push(`Name: ${goString(type.name)}`);
  if (type.kind === 'list') fields.push(`Item: &${goCheckType(type.item)}`);
  if (type.kind === 'map') fields.push(`Key: &${goCheckType(type.key)}`, `Value: &${goCheckType(type.value)}`);
  return `generatedType{${fields.join(', ')}}`;
}
const goCheckFields = (fields: Record<string, string>): string => `[]generatedField{${Object.entries(fields).map(([name, type]) => `{Name: ${goString(name)}, Type: ${goCheckType(descriptor(type))}}`).join(', ')}}`;

const goSpan = (span: Span): string => `ast.Span{${span.join(', ')}}`;
const goLines = (lines: number[]): string => `errs.LineIndex{${lines.join(', ')}}`;
/** A node that has a value: its result type is the Go type of that value. */
interface Typed { valueType: ValueType }
const goResult = (node: Typed): string => goType(node.valueType.source);
// An operand of a non-optional type where the result is optional: the optional type is a pointer in Go.
const goOperand = (expression: string, operand: Expr, node: Typed): string => goType(node.valueType.source).startsWith('*') && !goType(operand.valueType.source).startsWith('*') ? `generatedPointer(${expression})` : expression;

/** The Go type of a value of `type`; a merged type is optional without its source saying so. */
const goOf = (type: ValueType): string => goType(typeKey(type));
/**
 * The code of the value `code` of `from` as a value of `to`: the value itself when the Go types are the same, a pointer
 * to it for the optional type, its Value for any, and otherwise its Value decoded as `to`.
 */
function goConvert(code: string, from: ValueType, to: ValueType): string {
  if (goOf(from) === goOf(to)) return code;
  if (goOf(to) === `*${goOf(from)}`) return `generatedPointer(${code})`;
  if (goOf(to) === 'any') return `generatedValue(${code})`;
  return `generatedResult[${goOf(to)}](generatedValue(${code}))`;
}

/** `code` at `level`: every line that is not empty starts with `level` tabs. */
const tabs = (level: number, code: string): string => code.split('\n').map(line => line === '' ? '' : '\t'.repeat(level) + line).join('\n');
/** The lines of a statement list, without the empty parts. */
const lines = (...parts: (string | string[])[]): string => parts.flat().filter(part => part !== '').join('\n');
/** A block `{ ... }` after `head`, with its statements one level deeper. */
const braced = (head: string, ...body: (string | string[])[]): string => `${head} {\n${tabs(1, lines(...body))}\n}`;
/** A function literal that is called at once, with its statements one level deeper. */
const called = (signature: string, ...body: (string | string[])[]): string => `${braced(signature, ...body)}()`;

/**
 * A struct type with its fields aligned as gofmt aligns them: the cells of a column are padded to the widest cell of
 * the column, and the last cell of a field is not padded.
 */
function goStruct(name: string, rows: string[][]): string {
  if (rows.length === 0) return `type ${name} struct{}`;
  // The widest cell of a column among the cells that are not the last of their field.
  const width = (column: number): number => Math.max(...rows.flatMap(row => row.slice(0, -1).slice(column, column + 1).map(cell => cell.length)));
  const field = (row: string[]): string => row.map((cell, column) => column < row.length - 1 ? cell.padEnd(width(column)) : cell).join(' ');
  return `type ${name} struct {\n${rows.map(row => `\t${field(row)}`).join('\n')}\n}`;
}

export function createTarget({ program }: { program: Program }): Target {
  const undefinedBlock = (node: NodeOf<'block'>, id: string): string => `panic(runtime.Error(frame, ${goSpan(node.span)}, errs.RuntimeBlockUndefined, ${goString(`define ${id} is not registered`)}))`;
  const enterBlock = (node: NodeOf<'block'>, blockTarget: string, call: string): string[] => [
    'blockScope := render.NewScope()',
    `generatedEnter(context, ${goString(blockTarget)}, frame, ${goSpan(node.span)})`,
    called('func()', 'defer context.Leave()', call),
  ];
  const values = (args: string[]): string => `[]value.Value{${args.map(item => `generatedValue(${item})`).join(', ')}}`;
  // Each local is a variable of its typed value (FunctionLocals); the scope keeps its Value for includes and lookups.
  let locals = new FunctionLocals([]);
  // The item variable of each enclosing loop, innermost last.
  const loopItems: [loop: string, item: string][] = [];
  const loopItem = (loop: string): string => {
    const item = loopItems.findLast(([name]) => name === loop);
    if (item === undefined) throw new Error(`compiler backend go: loop ${loop} has no item`);
    return item[1];
  };
  // The variables that hold the merged locals after a branch or a loop, declared before it with the value before it.
  const declare = (merged: MergedLocal[]): string[] => merged.map(item => `var ${item.variable} ${goOf(item.type)} = ${goConvert(item.before.code, item.before.type, item.type)}`);
  // The statements at the end of a branch or a loop body that give each merged local the value that it has there.
  const assignMerged = (merged: MergedLocal[], except: string | null = null): string[] => merged.flatMap(item => {
    const end = locals.bindings.get(item.name);
    if (end === undefined) throw new Error(`compiler backend go: local ${item.name} has no binding`);
    return item.name === except || end.code === item.variable ? [] : [`${item.variable} = ${goConvert(end.code, end.type, item.type)}`];
  });
  const branch = (nodes: Node[], merged: MergedLocal[], except: string | null = null): string => lines(emitNodes(nodes, target, 0), assignMerged(merged, except));
  // A branching node that may assign locals: each branch starts from the bindings before it, and the locals hold the
  // merged values after it.
  const branching = (merged: MergedLocal[], n: number, emit: (body: (nodes: Node[]) => string) => string): string => {
    const start = locals.save();
    const code = emit(nodes => {
      locals.restore(start);
      return branch(nodes, merged);
    });
    locals.restore(start);
    locals.enter(merged);
    return tabs(n, lines(declare(merged), code));
  };
  const target: Target = {
    ...baseTarget(language),
    var: (name, type, node) => program.dynamicRoot ? node.scope ? `generatedResult[${goType(type)}](scope.Lookup(frame, ${goString(name)}))` : `generatedMember[${goType(type)}](runtime, rootData, ${goString(name)}, frame, ${goSpan(node.span)})` : `assign.${exportedName(name)}`,
    local: (_name, _type, node) => locals.read(node).code,
    set: (_name, value, level, node) => {
      const variable = locals.variable(node.name);
      locals.bindings.set(node.name, { code: variable, type: node.expr.valueType });
      return tabs(level, `var ${variable} ${goOf(node.expr.valueType)} = ${value}\nscope.Locals[${goString(node.name)}] = generatedValue(${variable})`);
    },
    member: (object, key, owner, node) => owner.kind === 'any' ? `generatedMember[${goResult(node)}](runtime, ${object}, ${goString(key)}, frame, ${goSpan(node.span)})` : `${object}.${exportedName(key)}`,
    text: (value, level, node) => tabs(level, `generatedWrite(context, ${goString(value)}, frame, ${goSpan(node.span)})`),
    echo: (expression, level, node) => tabs(level, `generatedWrite(context, generatedEscape(runtime, ${expression}, frame, ${goSpan(node.expr.span)}), frame, ${goSpan(node.span)})`),
    block: (node, n) => {
      if (node.target === null) {
        return tabs(n, braced('',
          `definition := definitions.${exportedName(node.id)}`,
          braced('if definition == nil || definition.HTML == nil', undefinedBlock(node, node.id)),
          `generatedWrite(context, *definition.HTML, frame, ${goSpan(node.span)})`).slice(1));
      }
      const blockTarget = node.target;
      const defaults = node.inputs.flatMap(item => item.root === null ? [] : [`${exportedName(item.name)}: ${emitExpression(item.root, target)}`]).join(', ');
      const defined = node.inputs.map(item => braced(`if definition.Data.${exportedName(item.name)} != nil`, `input.${exportedName(item.name)} = *definition.Data.${exportedName(item.name)}`));
      const scoped = node.inputs.flatMap(item => item.scope === null ? [] : [`input.${exportedName(item.name)} = ${emitExpression(item.scope, target)}`]);
      const call = `${functionName(blockTarget)}(assign, definitions, input, context, runtime, rootData, blockScope)`;
      const input = `input := ${inputName(blockTarget)}{${defaults}}`;
      if (node.id === null) return tabs(n, braced('', input, scoped, enterBlock(node, blockTarget, call)).slice(1));
      const id = node.id;
      const field = exportedName(id);
      const registryData = node.definition.template !== null ? definitionDataName(node.definition.template) : 'struct{}';
      const registration = node.path === null
        ? braced('if definition == nil', undefinedBlock(node, id))
        : `${braced('if definition == nil', `definition = &Definition[${registryData}]{Template: ${goString(blockTarget)}}`, `definitions.${field} = definition`)} else ${braced(`if definition.HTML != nil || definition.Template != ${goString(blockTarget)}`, `panic(runtime.Error(frame, ${goSpan(node.span)}, errs.RuntimeBlockRedefined, ${goString(`define ${id} is registered with a different template`)}))`)}`;
      return tabs(n, braced('',
        `definition := definitions.${field}`,
        registration,
        `${braced('if definition != nil && definition.HTML != nil', `generatedWrite(context, *definition.HTML, frame, ${goSpan(node.span)})`)} else ${braced('',
          input,
          defined.length > 0 ? braced('if definition != nil && definition.Data != nil', defined) : '',
          scoped,
          enterBlock(node, blockTarget, call)).slice(1)}`).slice(1));
    },
    // An if-block keeps the types of the locals that it assigns (the IR does not widen them).
    ifBlock: (node, n) => branching(locals.merged(assignedNames(program, [...node.body, ...node.otherwise ?? []]), null), n, body => {
      const then = body(node.body);
      const otherwise = node.otherwise ? body(node.otherwise) : null;
      return `${braced(`if definitions.${exportedName(node.id)} != nil`, then)}${otherwise === null ? '' : ` else ${braced('', otherwise).slice(1)}`}`;
    }),
    loopMeta: (loop, field) => field === 'value_' ? loopItem(loop) : `generatedLoopMeta(scope, ${goString(loop)}).${exportedName(field.replace(/_$/, ''))}`,
    toValue: value => `generatedValue(${value})`,
    index: (object, index, _owner, node) => `generatedIndex[${goResult(node)}](runtime, ${object}, ${index}, frame, ${goSpan(node.span)})`,
    memberCall: (object, method, args, node) => `generatedMemberCall[${goResult(node)}](runtime, generatedValue(${object}), ${goString(method)}, ${values(args)}, frame, ${goSpan(node.span)})`,
    classCall: (className, method, args, node) => `generatedClassCall[${goResult(node)}](runtime, ${goString(className)}, ${goString(method)}, ${values(args)}, frame, ${goSpan(node.span)})`,
    call: (name, args, node) => `generatedCall[${goResult(node)}](runtime, ${goString(name)}, ${values(args)}, frame, ${goSpan(node.span)})`,
    unary: (operator, operand, node) => `generatedUnary[${goResult(node)}](runtime, ${goString(operator)}, ${operand}, frame, ${goSpan(node.span)})`,
    binary: (operator, left, right, node) => {
      if (operator === '&&') return called('func() bool', `left := ${left}`, braced('if !generatedTruthy(runtime, left)', 'return false'), `return generatedTruthy(runtime, ${right})`);
      if (operator === '||') return called('func() bool', `left := ${left}`, braced('if generatedTruthy(runtime, left)', 'return true'), `return generatedTruthy(runtime, ${right})`);
      // `??` returns the left operand when it is not null: a pointer of an optional type is read through after the test.
      if (operator === '??') {
        const left_ = goType(node.left.valueType.source).startsWith('*') && !goResult(node).startsWith('*') ? '*left' : goOperand('left', node.left, node);
        return called(`func() ${goResult(node)}`, `left := ${left}`, braced('if generatedValue(left) != nil', `return ${left_}`), `return ${goOperand(right, node.right, node)}`);
      }
      return `generatedBinary[${goResult(node)}](runtime, ${goString(operator)}, ${left}, ${right}, frame, ${goSpan(node.span)})`;
    },
    ternary: (test, thenValue, elseValue, node) => called(`func() ${goResult(node)}`, braced(`if generatedTruthy(runtime, ${test})`, `return ${goOperand(thenValue, node.consequent, node)}`), `return ${goOperand(elseValue, node.otherwise, node)}`),
    list: (items, type, node) => {
      if (type.kind !== 'list') throw new Error(`compiler backend: a list literal has the type ${type.source}`);
      return `generatedDepth(runtime, ${called(`func() ${goType(type.source)}`,
        `result := ${goType(type.source)}{}`,
        items.map(item => item.spread ? `result = append(result, generatedListSpread[${goType(type.item.source)}](runtime, ${item.value}, frame, ${goSpan(item.span)})...)` : `result = append(result, ${item.value})`),
        'return result')}, frame, ${goSpan(node.span)})`;
    },
    map: (entries, type, node) => {
      if (type.kind !== 'map') throw new Error(`compiler backend: a map literal has the type ${type.source}`);
      return `generatedDepth(runtime, ${called(`func() ${goType(type.source)}`,
        `result := NewOrderedMap[${goType(type.key.source)}, ${goType(type.value.source)}]()`,
        entries.map(item => item.spread ? braced(`for _, entry := range generatedMapSpread[${goType(type.key.source)}, ${goType(type.value.source)}](runtime, ${item.value}, frame, ${goSpan(item.span)}).Entries()`, 'result.Set(entry.Key, entry.Value)') : `result.Set(${item.value[0]}, ${item.value[1]})`),
        'return result')}, frame, ${goSpan(node.span)})`;
    },
    // The tests read the locals before the if; a branch that assigns a local widens it as the IR does.
    ifNode: (node, n) => {
      const tested = node.branches.map(item => ({ test: emitExpression(item.test, target), statements: item.body }));
      return branching(locals.merged(assignedNames(program, [node]), node.widened), n, body => {
        const branches = tested.map(({ test, statements }) => braced(`if generatedTruthy(runtime, ${test})`, body(statements)));
        const otherwise = node.otherwise ? ` else ${braced('', body(node.otherwise)).slice(1)}` : '';
        return `${branches.join(' else ')}${otherwise}`;
      });
    },
    // A loop iterates the entries of a typed list or map as they are, and the entries of a Value through the runtime;
    // its item is a variable of the type of the items, which the body reads without a check.
    forNode: (node, n) => {
      const name = fieldName(node.name);
      const loop = goString(node.name);
      const iter = emitExpression(node.iter, target);
      const collection = node.iter.valueType;
      const typedIter = collection.optional ? `generatedDeref(${iter})` : iter;
      const entries = collection.kind === 'list' ? `generatedListEntries(${typedIter})`
        : collection.kind === 'map' ? `generatedMapEntries(${typedIter})`
        : `generatedEntries(runtime, ${iter}, frame, ${goSpan(node.span)})`;
      // The body reads the locals that it assigns as the IR widens them; the loop restores its variable.
      const names = assignedNames(program, node.body);
      names.delete(node.name);
      for (const item of assignedNames(program, node.empty ?? [])) names.add(item);
      const merged = locals.merged(names, node.widened);
      const declarations = declare(merged);
      locals.enter(merged);
      const start = locals.save();
      const item = locals.variable(node.name);
      locals.bindings.set(node.name, { code: item, type: node.itemType });
      loopItems.push([node.name, item]);
      const body = branch(node.body, merged, node.name);
      loopItems.pop();
      locals.restore(start);
      const empty = node.empty ? branch(node.empty, merged) : '';
      locals.restore(start);
      // The Value of a typed item is its encoding; the item of a Value is a Value.
      const itemValue = collection.kind === 'any' ? item : `${name}_value`;
      return tabs(n, lines(declarations, braced('',
        `entries := ${entries}`,
        'entriesSize := len(entries)',
        'lastIndex := entriesSize - 1',
        `previous, hadPrevious := scope.Locals[${loop}]`,
        braced(`for ${name}_index, entry := range entries`,
          `${name}_key, ${item} := entry.Key, entry.Value`,
          collection.kind === 'any' ? '' : `${itemValue} := generatedValue(${item})`,
          `scope.Locals[${loop}] = ${itemValue}`,
          `scope.Loops[${loop}] = append(scope.Loops[${loop}], &render.LoopMeta{Index: ${name}_index, Key: ${name}_key, Value: ${itemValue}, Size: entriesSize, First: ${name}_index == 0, Last: ${name}_index == lastIndex})`,
          'context.Iterations++',
          `generatedLimit(runtime, "iteration", context.Iterations, frame, ${goSpan(node.span)})`,
          body,
          `scope.Loops[${loop}] = scope.Loops[${loop}][:len(scope.Loops[${loop}])-1]`),
        `${braced('if hadPrevious', `scope.Locals[${loop}] = previous`)} else ${braced('', `delete(scope.Locals, ${loop})`).slice(1)}`,
        node.empty ? braced('if entriesSize == 0', empty) : '').slice(1)));
    },
    // An include may assign the locals of its caller in the shared scope (RT-21): each local that it may assign is
    // decoded once from the scope after it.
    include: (node, n) => {
      const call = [
        `generatedEnter(context, ${goString(node.target)}, frame, ${goSpan(node.span)})`,
        called('func()', 'defer context.Leave()', `${functionName(node.target)}(assign, definitions, ${inputName(node.target)}{${node.inputs.map(item => `${exportedName(item.name)}: ${emitExpression(item.value, target)}`).join(', ')}}, context, runtime, rootData, scope)`),
      ];
      const refreshed = [...assignedNames(program, [node])].flatMap(name => {
        const before = locals.bindings.get(name);
        if (before === undefined) return [];
        const variable = locals.variable(name, true);
        locals.bindings.set(name, { code: variable, type: before.type });
        return [`var ${variable} ${goOf(before.type)} = generatedResult[${goOf(before.type)}](scope.Lookup(frame, ${goString(name)}))`];
      });
      return tabs(n, lines(call, refreshed));
    },
    // The inputs of the template are the fields of its input, and the body reads each local from its variable.
    templateBody: (template, level) => {
      locals = new FunctionLocals([...template.inputs].map(([name, type]) => [name, { code: `input.${exportedName(name)}`, type }]));
      return locals.prune(emitNodes(template.body, target, level));
    },
  };
  return target;
}

const imports: [name: string, path: string][] = [
  ['bytes', '"bytes"'], ['json', '"encoding/json"'], ['errors', '"errors"'], ['fmt', '"fmt"'],
  ['template', 'template "github.com/polyspec/template/packages/go"'],
  ['ast', '"github.com/polyspec/template/packages/go/ast"'], ['errs', '"github.com/polyspec/template/packages/go/errs"'],
  ['functions', '"github.com/polyspec/template/packages/go/functions"'], ['render', '"github.com/polyspec/template/packages/go/render"'],
  ['value', '"github.com/polyspec/template/packages/go/value"'], ['time', '"time"'], ['utf8', '"unicode/utf8"'],
];

export function emitDeclarations(context: BackendContext): Part[] {
  const { program, manifest, templateBodies } = context;
  const fields = manifest.fields;
  const records = manifest.records;
  const tag = (name: string): string => `\`json:"${name}"\``;
  // A record reaches a runtime operation as a map of its declared fields in declaration order (VAL-21).
  const goRecords = Object.entries(records).flatMap(([name, members]) => [
    goStruct(name, Object.entries(members).map(([key, type]) => [exportedName(key), goType(type), tag(key)])),
    braced(`func (r ${name}) TemplateValue() value.Value`, 'result := value.NewOrderedMap()', Object.keys(members).map(key => `result.Set(${goString(key)}, generatedValue(r.${exportedName(key)}))`), 'return result'),
  ]);
  const inputTypes = templateBodies.map(template => goStruct(template.input, [...template.inputs].map(([name, type]) => [exportedName(name), goType(type.source), tag(name)])));
  const definitionDataTypes = templateBodies.map(template => goStruct(definitionDataName(template.name), [...template.inputs].map(([name, type]) => [exportedName(name), `*${goType(type.source)}`, tag(name)])));
  const definitionsType = goStruct('Definitions', [...program.definitions].map(([name, definition]) => [exportedName(name), `*Definition[${definition.template !== null ? definitionDataName(definition.template) : 'struct{}'}]`, tag(name)]));
  const assignType = goStruct('Assign', program.dynamicRoot ? [] : Object.entries(fields).map(([name, type]) => [exportedName(name), goType(type), tag(name)]));
  return [
    `${GO_HEADER}\n\npackage generated\n\nimport (`,
    // An import is kept when the program uses its package.
    ...imports.map(([name, path]) => definition(name, `\t${path}`, new RegExp(`\\b${name}\\.`))),
    ')',
    ...[...goRecords, assignType, ...inputTypes, ...definitionDataTypes,
      goStruct('Definition[T any]', [['Template', 'string', tag('template')], ['HTML', '*string', tag('html')], ['Data', '*T', tag('data')]]),
      definitionsType,
      goStruct('ArtifactManifest', ['Schema int', 'Mode string', 'Target string', 'Entry string', 'SourceDigest string', 'TypeDigest string', 'ContractDigest string', 'Files map[string]string'].map(row => row.split(' ')))].map(code => `\n${code}`),
    // The declared types of the request values, which generatedCheck reads; kept when the program checks a request value.
    definition('generatedRecordFields', `\nvar generatedRecordFields = map[string][]generatedField{${Object.entries(records).map(([name, members]) => `${goString(name)}: ${goCheckFields(members)}`).join(', ')}}`),
    definition('OrderedMap', `\n${goSource('ordered_map')}`,
    // The OrderedMap of the program, not value.OrderedMap of the runtime.
    /(?<![.\w])OrderedMap\b/),
  ];
}

// The helpers of the program in their order, each in `generated_<name>.go` and kept only when the program uses it.
const helpers = [
  'generatedPanic', 'generatedValue', 'generatedResult', 'generatedAs', 'generatedTruthy', 'generatedUnary', 'generatedBinary',
  'generatedMember', 'generatedIndex', 'generatedDepth', 'generatedMemberCall', 'generatedClassCall', 'generatedCall',
  'generatedEscape', 'generatedEntries', 'generatedEntry', 'generatedListEntries', 'generatedMapEntries', 'generatedDeref', 'generatedListSpread', 'generatedMapSpread', 'generatedLoopMeta', 'generatedWrite',
  'generatedEnter', 'generatedLimit', 'generatedPointer', 'generatedPlain', 'generatedCheck', 'generatedDecode', 'generatedEnv',
];

// A helper file that declares more than its name, used by any of its declarations.
const helperPatterns: Record<string, RegExp> = { generatedCheck: /\bgeneratedCheck(?:Fields)?\b/ };

export function emitRuntime(): Part[] {
  return helpers.map(name => definition(name, `\n${goSource(name.replace(/[A-Z]/g, letter => `_${letter.toLowerCase()}`))}`, helperPatterns[name]));
}

/** The statements of the body of `template` at level 0. */
function templateBody(target: Target, template: LoweredTemplate): string {
  if (target.templateBody === undefined) throw new Error('compiler backend go: the target emits no template body');
  return target.templateBody(template, 0);
}

export function emitTemplates(context: BackendContext): Part[] {
  return context.templateBodies.map(template => {
    const typed = loweredTemplate(context.program, template.name);
    return `\n${braced(`func ${template.function}(assign Assign, definitions *Definitions, input ${template.input}, context *render.Context, runtime *render.RuntimeBindings, rootData *value.OrderedMap, scope *render.Scope)`,
      `frame := render.NewFrame(${goString(template.name)}, ${goLines(typed.lines)}, rootData)`,
      [...template.inputs].map(([name]) => `scope.Locals[${goString(name)}] = generatedValue(input.${exportedName(name)})`),
      // The statements of the body at level 0, which the function places one level deeper.
      templateBody(context.target, typed))}`;
  });
}

function definitionCase(context: BackendContext, id: string, definition: Definition): string {
  const field = exportedName(id);
  const dataType = definition.template !== null ? definitionDataName(definition.template) : 'struct{}';
  const inputs = definition.template !== null ? [...loweredTemplate(context.program, definition.template).inputs] : [];
  const fail = (message: string): string => `return nil, nil, fmt.Errorf(${goString(message)}, id)`;
  const html = definition.html
    ? braced('if input.HTML != nil',
      braced('if input.Template != "" || input.Data != nil', fail('define.%s has an invalid html entry')),
      `definitions.${field} = &Definition[${dataType}]{HTML: input.HTML}`,
      'targets[id] = generatedTarget{html: input.HTML}',
      'continue')
    : braced('if input.HTML != nil', fail('define.%s has an invalid html entry'));
  // Definition data is bound as its own value and converted field by field, so a native object in an `any` field stays
  // the original value (VAL-18, VAL-20).
  const converted = inputs.map(([name, type]) => braced(`if raw, found := data.Get(${goString(name)}); found`,
    braced(`if err := generatedCheck(raw, ${goCheckType(descriptor(type.source))}, generatedRecordFields, "define."+id+".data."+${goString(name)}); err != nil`, 'return nil, nil, err'),
    `converted, err := generatedAs[${goType(type.source)}](raw)`,
    braced('if err != nil', `return nil, nil, fmt.Errorf("define.%s.data.%s: %w", id, ${goString(name)}, err)`),
    `definitionData.${exportedName(name)} = &converted`));
  const notMap = fail('define.%s.data is not an object');
  const data = braced('if input.Data != nil',
    'bound, err := value.BindData(input.Data)',
    braced('if err != nil', 'return nil, nil, err'),
    converted.length > 0 ? ['data, ok := bound.(*value.OrderedMap)', braced('if !ok', notMap)] : braced('if _, ok := bound.(*value.OrderedMap); !ok', notMap),
    `definitionData := ${dataType}{}`,
    converted,
    'entry.Data = &definitionData');
  return `case ${goString(id)}:\n${tabs(1, lines(
    html,
    braced(`if input.Template != ${goString(definition.template ?? '')}`, fail('define.%s has an invalid template')),
    `entry := &Definition[${dataType}]{Template: input.Template}`,
    data,
    `definitions.${field} = entry`,
    `targets[id] = generatedTarget{target: ${goString(definition.template ?? '')}}`))}`;
}

export function emitEntry(context: BackendContext): Part[] {
  const dispatch = context.templateBodies.filter(template => template.inputs.size === 0).map(template => `case ${goString(template.name)}:\n${tabs(1, `${template.function}(assign, definitions, ${template.input}{}, context, runtime, rootData, scope)\nreturn`)}`);
  const definitions = [...context.program.definitions];
  const cases = definitions.map(([id, definition]) => definitionCase(context, id, definition));
  // The values of the request are checked against their declared types, with the messages of ERR-13, before they are
  // decoded (T24.33).
  const bindAssign = context.program.dynamicRoot ? '' : lines(
    braced(`if err := generatedCheckFields(rootData, ${goCheckFields(context.manifest.fields)}, generatedRecordFields, "assign"); err != nil`, 'return nil, err'),
    braced('if err := generatedDecode(rootData, &typedAssign); err != nil', 'return nil, err'));
  const failure = (message: string): string => `return "", ${message}`;
  return [
    `\n${braced('func renderTemplate(target string, assign Assign, definitions *Definitions, context *render.Context, runtime *render.RuntimeBindings, rootData *value.OrderedMap, scope *render.Scope)',
      `switch target {\n${lines(dispatch, 'default:', tabs(1, 'panic(context.Fail(errs.LoadNotFound, nil, nil, "template "+target+" does not exist"))'))}\n}`)}`,
    `\n${goStruct('generatedTarget', [['target', 'string'], ['html', '*string']])}`,
    `\n${braced('func generatedBindDefinitions(input map[string]template.DefineInput) (*Definitions, map[string]generatedTarget, error)',
      'definitions := &Definitions{}',
      'targets := map[string]generatedTarget{}',
      braced(definitions.length > 0 ? 'for id, input := range input' : 'for id := range input',
        braced('if !utf8.ValidString(id)', 'return nil, nil, &value.BindError{Code: errs.DataInvalidUTF8, Message: "a define id is not valid UTF-8"}'),
        `switch id {\n${lines(cases, 'default:', tabs(1, 'return nil, nil, fmt.Errorf("define.%s is not declared", id)'))}\n}`),
      'return definitions, targets, nil')}`,
    `\n${goStruct('GeneratedProgram', [['Runtime', '*template.RuntimeEnvironment']])}`,
    `\n${braced('func NewGeneratedProgram(options template.Options) (*GeneratedProgram, error)',
      'runtime, err := template.NewRuntimeEnvironment(options.Limits, options.Functions)',
      braced('if err != nil', 'return nil, err'),
      'return &GeneratedProgram{Runtime: runtime}, nil')}`,
    `\n${goStruct('generatedPrepared', [['name', 'string'], ['target', 'string'], ['assign', 'Assign'], ['definitions', '*Definitions'], ['rootData', '*value.OrderedMap'], ['env', 'functions.Env'], ['runtime', '*template.RuntimeEnvironment'], ['html', '*string']])}`,
    `\n${braced('func (p *generatedPrepared) Render() (string, error)', 'return render.Guard(p.name, p.render)')}`,
    `\n${braced('func (p *generatedPrepared) render() (string, error)',
      'context := render.NewContext(p.runtime, p.rootData, p.env, p.target)',
      'runtime := render.NewRuntimeBindings(context)',
      'scope := render.NewScope()',
      braced('if err := context.Enter(p.target, nil, nil); err != nil', failure('err')),
      'defer context.Leave()',
      `${braced('if p.html != nil', braced('if err := context.Write(*p.html, nil, nil); err != nil', failure('err')))} else ${braced('', 'renderTemplate(p.target, p.assign, p.definitions, context, runtime, p.rootData, scope)').slice(1)}`,
      'return context.Output(), nil')}`,
    `\n${braced('func (p *GeneratedProgram) Prepare(target any, assign any, options template.RenderOptions) (template.Prepared, error)',
      'name, ok := target.(string)',
      braced('if !ok', 'return nil, fmt.Errorf("generated target must be a template name")'),
      `return render.Guard(name, ${braced('func() (template.Prepared, error)', 'return p.prepare(name, assign, options)')})`)}`,
    `\n${braced('func generatedBindFailure(name string, err error) error',
      'var bindError *value.BindError',
      braced('if errors.As(err, &bindError)', 'return errs.WithoutPosition(bindError.Code, name, bindError.Message)'),
      'return err')}`,
    `\n${braced('func (p *GeneratedProgram) prepare(name string, assign any, options template.RenderOptions) (template.Prepared, error)',
      'rootData, err := value.BindMap(assign)',
      braced('if err != nil', 'return nil, generatedBindFailure(name, err)'),
      'var typedAssign Assign',
      bindAssign,
      'definitions, targets, err := generatedBindDefinitions(options.Define)',
      braced('if err != nil', 'return nil, generatedBindFailure(name, err)'),
      'resolved := targets[name]',
      'targetName := name',
      braced('if resolved.target != ""', 'targetName = resolved.target'),
      'return &generatedPrepared{name: name, target: targetName, assign: typedAssign, definitions: definitions, rootData: rootData, env: generatedEnv(options), runtime: p.Runtime, html: resolved.html}, nil')}`,
    `\n${braced('func (p *GeneratedProgram) Render(target any, assign any, options template.RenderOptions) (string, error)',
      'prepared, err := p.Prepare(target, assign, options)',
      braced('if err != nil', failure('err')),
      'return prepared.Render()')}`,
    '\nvar _ template.Program = (*GeneratedProgram)(nil)',
  ];
}
