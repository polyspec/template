{
  "name": "@polyspec/template-compiler",
  "version": "0.0.6",
  "description": "Build-time compiler of template sources: canonical AST artifacts, type manifests and generated TypeScript, Go, Rust and PHP programs",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./compiler.mjs": {
      "types": "./dist/compiler.d.mts",
      "import": "./dist/compiler.mjs"
    },
    "./ast-artifact.mjs": {
      "types": "./dist/ast-artifact.d.mts",
      "import": "./dist/ast-artifact.mjs"
    },
    "./type-manifest.mjs": {
      "types": "./dist/type-manifest.d.mts",
      "import": "./dist/type-manifest.mjs"
    },
    "./functions.json": "./functions.json"
  },
  "files": [
    "dist",
    "backends/go",
    "interface.json",
    "functions.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26.11.1"
  },
  "dependencies": {
    "@polyspec/template": "0.0.6",
    "ajv": "^8.20.0"
  }
}
