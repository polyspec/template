#!/bin/sh
# The pre-push hook (T17.1-3). Every make invocation sets core.hooksPath to .githooks. The push gate refuses the push
# while a task of docs/plans/execution-checklist.md is [~] in a pushed commit or in the working tree, and when it cannot
# read a checklist; it reads the lines of Git on standard input. A failure to start it also refuses the push.
cd "$(git rev-parse --show-toplevel)" || exit 1
exec node scripts/push-gate.mjs hook
