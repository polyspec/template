{
  "schema": 1,
  "repositoryUrl": "https://github.com/polyspec/template",
  "changelog": "CHANGELOG.md",
  "changelogTranslations": [
    "CHANGELOG.ko.md"
  ],
  "packages": [
    {
      "kind": "npm",
      "directory": "packages/ts",
      "name": "@polyspec/template",
      "product": "template",
      "runtime": "ts"
    },
    {
      "kind": "npm",
      "directory": "packages/language",
      "name": "@polyspec/template-language",
      "product": "template-language",
      "runtime": "ts"
    },
    {
      "kind": "npm",
      "directory": "packages/lsp",
      "name": "@polyspec/template-lsp",
      "product": "template-lsp",
      "runtime": "ts"
    },
    {
      "kind": "npm",
      "directory": "packages/codemirror",
      "name": "@polyspec/template-codemirror",
      "product": "template-codemirror",
      "runtime": "ts"
    },
    {
      "kind": "npm",
      "directory": "packages/compiler",
      "name": "@polyspec/template-compiler",
      "product": "template-compiler",
      "runtime": "ts"
    },
    {
      "kind": "composer",
      "directory": "packages/php",
      "name": "polyspec/template",
      "product": "template",
      "runtime": "php"
    },
    {
      "kind": "composer",
      "directory": "packages/cli/php",
      "name": "polyspec/template-cli",
      "product": "template-cli",
      "runtime": "php"
    },
    {
      "kind": "composer",
      "directory": "packages/php-ext",
      "name": "polyspec/template-php-ext",
      "product": "template",
      "runtime": "php-ext"
    },
    {
      "kind": "wheel",
      "directory": "packages/python",
      "name": "polyspec-template",
      "product": "template",
      "runtime": "python"
    }
  ],
  "manifests": {
    "package.json": "version",
    "packages/ts/package.json": "archive",
    "packages/language/package.json": "archive",
    "packages/lsp/package.json": "archive",
    "packages/codemirror/package.json": "archive",
    "packages/compiler/package.json": "archive",
    "packages/vscode/package.json": "version",
    "packages/php/composer.json": "archive",
    "packages/php-ext/composer.json": "archive",
    "packages/rust/Cargo.toml": "git-tag",
    "packages/python/pyproject.toml": "archive",
    "packages/cli/php/composer.json": "archive"
  },
  "notReleased": {
    "composer.json": "the development root of the Composer packages of packages/, never published",
    "packages/vscode/tests/integration/harness/package.json": "the harness of the VS Code integration test",
    "examples/showcase/adapters/rust/Cargo.toml": "the Rust adapter of the showcase",
    "examples/showcase/adapters/go/go.mod": "the Go adapter of the showcase, a module local to the repository"
  },
  "goModules": {
    "packages/go": "github.com/polyspec/template/packages/go"
  }
}
