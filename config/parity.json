{
  "schema": 1,
  "comment": "The implementations of the template language and the shared units that each holds, checked by make parity-declarations-check and make parity-check of kit (T24.7). The conformance cases of tests/cases, their tokens and format results and the expression vectors of tests/fixtures/expr/cases.json are the shared suites; the editor packages, the compiler and the repository tools are single-language tools; every other test file of an implementation is the native test of a feature unit (T24.8, T24.11).",
  "implementations": [
    { "name": "ts", "runner": "vitest", "prose": ["TypeScript"], "roots": ["packages/ts", "packages/language"], "tests": ["packages/ts/tests/**/*.test.ts", "packages/language/tests/**/*.test.ts"], "errors": { "file": "packages/ts/src/errors.ts", "pattern": "^  \\| '(E_[A-Z0-9_]+)'" } },
    { "name": "go", "runner": "go", "prose": ["Go"], "roots": ["packages/go"], "tests": ["packages/go/**/*_test.go"], "errors": { "file": "packages/go/errs/errs.go", "pattern": "^\\t\\w+\\s+Code = \"(E_[A-Z0-9_]+)\"$" } },
    { "name": "rust", "runner": "cargo", "prose": ["Rust"], "roots": ["packages/rust"], "tests": ["packages/rust/tests/*.rs"], "support": ["packages/rust/tests/common/*.rs"], "errors": { "file": "packages/rust/src/error.rs", "pattern": "^    (E_[A-Z0-9_]+),$" } },
    { "name": "php", "runner": "php", "prose": ["PHP"], "roots": ["packages/php"], "tests": ["packages/php/tests/**/*Test.php"], "errors": { "file": "packages/php/src/ErrorCode.php", "pattern": "^    public const (E_[A-Z0-9_]+) = '" } },
    { "name": "php-ext", "runner": "php", "prose": ["PHP extension"], "roots": ["packages/php-ext"], "tests": ["packages/php-ext/tests/*Test.php"], "args": ["-d", "extension=var/build/polyspec_template.so"], "errors": { "file": "packages/php-ext/src/pt_error_codes.h", "pattern": "^#define PT_(E_[A-Z0-9_]+) \"" } },
    { "name": "python", "runner": "python", "prose": ["Python"], "roots": ["packages/python"], "tests": ["packages/python/tests/test_*.py"], "command": "var/python/venv/bin/python", "errors": { "file": "packages/python/src/polyspec/template/errors.py", "pattern": "^    \"(E_[A-Z0-9_]+)\",$" } }
  ],
  "profiles": [
    { "name": "runtime", "implementations": ["ts", "go", "rust", "php", "php-ext", "python"] },
    { "name": "manifest", "implementations": ["ts", "go", "rust", "php", "python"], "reason": "The PHP extension is the native renderer of the PHP package and declares no support level of packages/compiler/interface.json and no entry of the function contract (RT-55, RT-56): its PHP surface is Engine (parse, analyze, render and register over a template directory), BoundMap and TemplateError, so the loader interface, the artifact refresh of a program, the page cache, the value and number operations, the function registry, the formatter and the declarations of the manifest mapping are absent, and a PHP host reaches them in the PHP package that the extension requires.", "spec": ["docs/spec/runtime.md#support-levels-and-compiled-artifacts", "docs/spec/functions.md#canonical-contract"] },
    { "name": "export-list", "implementations": ["ts", "python"], "reason": "Names follow the conventions of each language (RT-1): the TypeScript and Python packages name their public API in an export list, the re-exports of the entry points of package.json and __all__ with the package data of pyproject.toml, which a test keeps complete; Go, Rust and PHP export a declaration by its visibility, which their compilers check.", "spec": ["docs/spec/runtime.md#api"] },
    { "name": "language-service", "implementations": ["ts"], "reason": "The language service and its command template-fmt, the editor documents and the template root are one TypeScript package, @polyspec/template-language, which the editor adapters use (EDT layers).", "spec": ["docs/spec/editor.md#layers"] },
    { "name": "concurrent-renders", "implementations": ["go", "python"], "reason": "Renders of one program run at the same time where the host language runs code concurrently (RT-70): Go renders one program and one bound map from concurrent goroutines and Python from concurrent threads, while a Rust program and its bound maps stay in the thread that created them, TypeScript and PHP run one render at a time in a process or worker, and the PHP extension keeps the objects of a request in that request.", "spec": ["docs/spec/runtime.md#api", "docs/spec/data-model.md#bound-data"] },
    { "name": "checked-arguments", "implementations": ["ts", "php", "php-ext", "python"], "reason": "The parameters of bind and merge accept any value where the host language checks types at run time (VAL-22): TypeScript, PHP, the PHP extension and Python check inside the operation that the argument of merge is a bound map of the same implementation, while Go and Rust declare the bound map type of the parameter, which their compilers check.", "spec": ["docs/spec/data-model.md#bound-data"] }
  ],
  "suites": ["tests/fixtures/expr/cases.json"],
  "errors": { "profile": "runtime", "catalog": { "file": "docs/spec/errors.md", "pattern": "^\\| `(E_[A-Z0-9_]+)` \\||^(?!\\| `E_)" } },
  "comparators": ["tests/runner", "tests/browser", "examples/showcase"],
  "tools": [
    { "root": "packages/lsp", "reason": "The language server is a TypeScript tool of the editors." },
    { "root": "packages/codemirror", "reason": "The CodeMirror adapter is a TypeScript tool of the editors." },
    { "root": "packages/vscode", "reason": "The VS Code extension is a TypeScript tool of the editors." },
    { "root": "packages/compiler", "reason": "The compiler generates the programs of every language from one TypeScript implementation." },
