[
  {
    "name": "same-name-twice",
    "requirements": ["RT-8", "RT-10"],
    "files": { "input.tpl": "{+ part.tpl}{+ ./part.tpl}", "part.tpl": "x" },
    "expected": { "html": "xx" }
  },
  {
    "name": "nested-directory",
    "requirements": ["RT-10"],
    "files": { "input.tpl": "{+ a/b/part.tpl}", "a/b/part.tpl": "x" },
    "expected": { "html": "x" }
  },
  {
    "name": "directory-name",
    "requirements": ["RT-9", "RT-10"],
    "files": { "input.tpl": "{+ folder.tpl}", "folder.tpl/inner.tpl": "x" },
    "expected": { "raises": {"kind": "load_failed", "status": null, "category": "io", "message": null, "properties": {"template": "input.tpl", "line": 1, "col": 1}} }
  },
  {
    "name": "file-as-directory",
    "requirements": ["RT-10"],
    "files": { "input.tpl": "{+ part.tpl/inner.tpl}", "part.tpl": "x" },
    "expected": { "raises": {"kind": "load_not_found", "status": null, "category": "value", "message": null, "properties": {"template": "input.tpl", "line": 1, "col": 1}} }
  },
  {
    "name": "missing-name",
    "requirements": ["RT-10"],
    "files": { "input.tpl": "{+ missing.tpl}" },
    "expected": { "raises": {"kind": "load_not_found", "status": null, "category": "value", "message": null, "properties": {"template": "input.tpl", "line": 1, "col": 1}} }
  },
  {
    "name": "symbolic-link-file",
    "requirements": ["RT-10"],
    "files": { "input.tpl": "a{+ part.tpl}", "target.tpl": "x" },
    "symbolicLinks": { "part.tpl": "target.tpl" },
    "expected": { "raises": {"kind": "load_failed", "status": null, "category": "io", "message": null, "properties": {"template": "input.tpl", "line": 1, "col": 2}} }
  },
  {
    "name": "symbolic-link-directory",
    "requirements": ["RT-10"],
    "files": { "input.tpl": "{+ linked/part.tpl}", "real/part.tpl": "x" },
    "symbolicLinks": { "linked": "real" },
    "expected": { "raises": {"kind": "load_failed", "status": null, "category": "io", "message": null, "properties": {"template": "input.tpl", "line": 1, "col": 1}} }
  },
  {
    "name": "symbolic-link-dangling",
    "requirements": ["RT-10"],
    "files": { "input.tpl": "{+ part.tpl}" },
    "symbolicLinks": { "part.tpl": "missing.tpl" },
    "expected": { "raises": {"kind": "load_failed", "status": null, "category": "io", "message": null, "properties": {"template": "input.tpl", "line": 1, "col": 1}} }
  },
  {
    "name": "symbolic-link-block",
    "requirements": ["RT-10", "RT-29"],
    "files": { "input.tpl": "{# part.tpl}", "target.tpl": "x" },
    "symbolicLinks": { "part.tpl": "target.tpl" },
    "expected": { "raises": {"kind": "load_failed", "status": null, "category": "io", "message": null, "properties": {"template": "input.tpl", "line": 1, "col": 1}} }
  },
  {
    "name": "hard-link-second-name",
    "requirements": ["RT-10"],
    "files": { "input.tpl": "{+ part.tpl}\n{+ copy.tpl}", "part.tpl": "x" },
    "hardLinks": { "copy.tpl": "part.tpl" },
    "expected": { "raises": {"kind": "load_failed", "status": null, "category": "io", "message": null, "properties": {"template": "input.tpl", "line": 2, "col": 1}} }
  },
  {
    "name": "hard-link-of-entry",
    "requirements": ["RT-10"],
    "files": { "input.tpl": "{+ copy.tpl}" },
    "hardLinks": { "copy.tpl": "input.tpl" },
    "expected": { "raises": {"kind": "load_failed", "status": null, "category": "io", "message": null, "properties": {"template": "input.tpl", "line": 1, "col": 1}} }
  }
]
