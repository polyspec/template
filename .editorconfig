root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.php]
indent_size = 4

[*.rs]
indent_size = 4

[*.{c,h}]
indent_size = 4

# The arginfo header that gen_stub.php generates from the stub of the C extension: its indentation follows the generator.
[packages/template-php-ext/src/*_arginfo.h]
indent_style = unset

[Makefile]
indent_style = tab

[*.tpl]
trim_trailing_whitespace = false

# Byte-exact inputs and expected outputs of tests: an editor keeps their bytes.
[{tests/cases,tests/fixtures}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# Files that `make showcase` writes: their indentation follows the generator.
[{examples/site/index.html,tools/showcase/adapters/*/generated/**}]
indent_style = unset
