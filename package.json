{
  "name": "@polyspec/template-workspace",
  "version": "0.0.6",
  "private": true,
  "description": "Template language with one specification and TypeScript, Go, Rust and PHP implementations",
  "type": "module",
  "scripts": {
    "test": "node tests/runner/conformance.mts",
    "test:browser": "node packages/ts/tests/browser/run.mts",
    "schema:check": "node scripts/check-schema.mts",
    "docs:coverage": "node scripts/check-doc-coverage.mts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26.11.1"
  },
  "packageManager": "npm@12.2.0",
  "workspaces": [
    "packages/ts",
    "packages/language",
    "packages/lsp",
    "packages/codemirror",
    "packages/compiler",
    "packages/vscode"
  ],
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@playwright/test": "^1.64.0",
    "@polyspec/kit": "https://github.com/polyspec/kit/releases/download/v0.0.43/polyspec-kit-npm-0.0.43.tgz",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "^1.138.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.27.2",
    "oxc-parser": "^0.153.0",
    "picomatch": "^4.0.7",
    "smol-toml": "^1.9.1",
    "tsup": "^8.5.1",
    "typescript": "7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3",
    "vscode-jsonrpc": "^9.0.3"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.3"
    }
  }
}
