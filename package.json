{
  "name": "@polyspec/template-workspace",
  "version": "0.0.13",
  "private": true,
  "description": "Template language with one specification and TypeScript, Go, Rust and PHP implementations",
  "type": "module",
  "scripts": {
    "test": "node tests/runner/conformance.mts",
    "test:browser": "node tests/browser/run.mts",
    "schema:check": "node scripts/check-schema.mts",
    "docs:coverage": "node scripts/check-doc-coverage.mts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26.12.0"
  },
  "packageManager": "npm@12.2.0",
  "workspaces": [
    "packages/ts",
    "packages/language",
    "packages/lsp",
    "packages/codemirror",
    "packages/compiler",
    "packages/vscode"
  ],
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@polyspec/kit": "https://github.com/polyspec/kit/releases/download/v0.0.72/polyspec-kit-npm-0.0.72.tgz",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.138.0",
    "@vscode/test-electron": "^3.1.0",
    "@vue/compiler-dom": "^3.5.44",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.28.2",
    "oxc-parser": "^0.156.0",
    "picomatch": "^4.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "^1.9.1",
    "tsup": "^9.0.0",
    "typescript": "7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "vscode-jsonrpc": "^10.0.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.5"
    },
    "@azure/identity": {
      "@azure/msal-node": "7.1.0"
    }
  }
}
