#!/usr/bin/env node
// Lints the generated programs as the code of a consumer (T25.1): the committed showcase artifacts, which
// make artifact-digest-check holds to the compiler of the tree, are the generated fixture of each target. Each target
// passes the formatter and the unused-code lint of its ecosystem at the versions that this repository pins:
// - Go: the header of the Go convention for generated code, `gofmt -l` lists no file, and golangci-lint `unused` reports
//   nothing. golangci-lint skips a file with that header by default (exclusions.generated: lax), so this check runs it
//   with a configuration of its own that lints generated files.
// - Rust: clippy with -D warnings on a crate whose library has a public module for each program, so the public API of a
//   program is used and only what the program does not use is dead code.
// - TypeScript: oxlint `no-unused-vars`.
// The Rust and TypeScript checks also compile tests/fixtures/generated-lint, a program without definitions whose loops
// read no metadata, as template-benchmark compiles its program (T24.29). Its Rust program is a private module of the
// binary of the crate, which renders it as a consumer does: an item that rendering does not use is dead code, public or
// not.
// - Python: `ruff format --check` and `ruff check` with ruff.toml, and vulture at its default confidence on the programs
//   with the showcase adapter that uses them, so the public GeneratedProgram is used (T25.3).
// - PHP: `pint --test --preset psr12` and phpcs with phpcs.xml.dist (PSR-12), whose warnings, such as a line of more
//   than 120 columns, fail the check as its errors do.
import { spawnSync } from 'node:child_process';
import { readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { join, resolve } from 'node:path';
import { checkLanguages } from './language-checks.mts';
import { showcasePhpDirectory } from '../examples/showcase/php-namespace.mts';
import { showcasePythonModule } from '../examples/showcase/python-module.mts';
import { CARGO, root, rustWorkspace, temporaryDirectory } from './temporary-workspace.mts';
import { compileAst } from '../packages/compiler/src/ast-artifact.mts';
import { compileSource } from '../packages/compiler/src/compiler.mts';

export const GO_HEADER = '// Code generated by @polyspec/template-compiler. DO NOT EDIT.';

const adapters = join(root, 'examples/showcase/adapters');
const typed = join(adapters, 'generated/typed');
const scenarios = readdirSync(join(root, 'examples/site/scenarios'), { withFileTypes: true })
  .filter(entry => entry.isDirectory())
  .map(entry => entry.name)
  .sort();
if (scenarios.length === 0) throw new Error('examples/site/scenarios holds no scenario');
const goFiles = scenarios.map(id => join(adapters, 'go/generated', id, 'generated.go'));
const typedFiles = (extension: string): string[] => scenarios.map(id => join(typed, `${id}.${extension}`));

function run(command: string, args: string[], options: { cwd?: string; env?: NodeJS.ProcessEnv; quiet?: boolean } = {}): string {
  const result = spawnSync(command, args, { cwd: options.cwd ?? root, encoding: 'utf8', env: { ...process.env, ...options.env }, maxBuffer: 64 * 1024 * 1024 });
  if (result.error) throw result.error;
  if (result.status !== 0 || (options.quiet && result.stdout.trim() !== '')) {
    throw new Error(`${command} ${args.join(' ')} exited with ${result.status}\n${result.stdout}${result.stderr}`.trim());
  }
  return result.stdout;
}

function checkGo() {
  for (const file of goFiles) {
    const first = readFileSync(file, 'utf8').split('\n', 1)[0];
    if (first !== GO_HEADER) throw new Error(`${file}: the first line is ${JSON.stringify(first)}, not ${JSON.stringify(GO_HEADER)}`);
  }
  run('gofmt', ['-l', ...goFiles], { quiet: true });
  const directory = temporaryDirectory('generated-lint-go');
  try {
    const config = join(directory, 'golangci.yml');
    writeFileSync(config, 'version: "2"\nlinters:\n  default: none\n  enable:\n    - unused\n  exclusions:\n    generated: disable\n');
    run('golangci-lint', ['run', '--config', config, './generated/...'], { cwd: join(adapters, 'go') });
  } finally {
    rmSync(directory, { recursive: true, force: true });
  }
}

const FIXTURE = join(root, 'tests/fixtures/generated-lint');

/** The program of tests/fixtures/generated-lint in `language`, compiled into the directory `directory`. */
function compileFixture(directory: string, language: 'rust' | 'ts'): string {
  const graph = join(directory, 'ast');
  const types = join(FIXTURE, 'types.json');
  compileAst({ root: FIXTURE, output: graph, entry: 'page.tpl', typeManifest: types });
  const file = join(directory, `generated-lint.${language}`);
  writeFileSync(file, compileSource(join(graph, 'manifest.json'), types, language));
  return file;
}

function checkRust() {
  const crate = rustWorkspace('generated-lint-rust');
  try {
    const modules = scenarios.map(id => `pub mod ${id.replaceAll('-', '_')} {\n    include!(${JSON.stringify(join(typed, `${id}.rust`))});\n}\n`).join('');
    writeFileSync(join(crate.directory, 'src/lib.rs'), modules);
    const fixture = compileFixture(crate.directory, 'rust');
    writeFileSync(join(crate.directory, 'src/main.rs'), `use polyspec_template::{Program, RenderOptions, RenderTarget, RuntimeEnvironment};
use std::collections::HashMap;
mod generated {
    include!(${JSON.stringify(fixture)});
}
fn main() {
    let program = generated::GeneratedProgram::new(RuntimeEnvironment::new(None, HashMap::new()));
    match program.render(RenderTarget::Name("page.tpl"), &serde_json::Value::Null, &RenderOptions::default()) {
        Ok(output) => println!("{output}"),
        Err(error) => eprintln!("{error}"),
    }
}
`);
    run(CARGO, ['clippy', '--locked', '--offline', '--manifest-path', crate.manifest, '--lib', '--bin', 'template-generated-check', '--', '-D', 'warnings'], { env: { CARGO_TARGET_DIR: crate.targetDirectory } });
  } finally {
    rmSync(crate.directory, { recursive: true, force: true });
  }
}

function checkTypeScript() {
  const directory = temporaryDirectory('generated-lint-ts');
  try {
    run(resolve(root, 'node_modules/.bin/oxlint'), ['--allow', 'all', '--deny', 'no-unused-vars', ...typedFiles('ts'), compileFixture(directory, 'ts')]);
  } finally {
    rmSync(directory, { recursive: true, force: true });
  }
}

function checkPython() {
  const files = scenarios.map(id => join(typed, `${showcasePythonModule(id)}.py`));
  run('ruff', ['format', '--check', '--config', 'ruff.toml', ...files]);
  run('ruff', ['check', '--config', 'ruff.toml', ...files]);
  run('vulture', [...files, join(adapters, 'python.py'), join(adapters, 'generated/render_adapter.py')]);
}

function checkPhp() {
  // The PHP program of a scenario is a directory of PSR-4 files (T25.1).
  const files = scenarios.flatMap(id => readdirSync(join(root, showcasePhpDirectory(id))).map(name => join(root, showcasePhpDirectory(id), name)));
  run(join(root, 'vendor/bin/pint'), ['--test', '--preset', 'psr12', ...files]);
  run('phpcs', ['--standard=phpcs.xml.dist', ...files]);
}

checkLanguages('generated lint', { Go: checkGo, Rust: checkRust, TypeScript: checkTypeScript, Python: checkPython, PHP: checkPhp });
process.stdout.write(`generated lint: the Go, Rust, TypeScript, Python and PHP programs of ${scenarios.length} scenarios pass\n`);
