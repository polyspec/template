#!/usr/bin/env node
// Generates the error-code list of each implementation from the code tables of docs/spec/errors.md, the catalog of errors
// in config/parity.json (T22.6-15). Each code is a row `| `E_...` | <condition> | <position> |` of a table of ERR-7 to
// ERR-12; the order of the rows is the order of every list. A list in a source file lies between the lines
// `BEGIN GENERATED ERROR CODES` and `END GENERATED ERROR CODES` in the comment syntax of its language, and the generator
// writes only the lines between them; the PHP class and the header of the PHP extension are whole generated files. R7 of
// make parity-declarations-check reads each list with the pattern of its implementation in config/parity.json; this check
// keeps the lists equal to the catalog before that.
//
// Usage: node scripts/generate-error-codes.mts [--check]
import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { parseArgs } from 'node:util';

export const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');
export const CATALOG = 'docs/spec/errors.md';

/** A code of the catalog and the condition that its table row states. */
export type CatalogCode = { code: string; condition: string };

const ROW = /^\| `(E_[A-Z0-9_]+)` \| (.+?) \| .+ \|$/;

/** The codes of the tables of the catalog text, in their order; a code that appears twice is an error. */
export function parseCatalog(text: string): CatalogCode[] {
  const codes: CatalogCode[] = [];
  text.split('\n').forEach((line, index) => {
    if (!line.startsWith('| `E_')) return;
    const match = ROW.exec(line);
    if (!match?.[1] || !match[2]) throw new Error(`${CATALOG}:${index + 1}: the row ${JSON.stringify(line)} is no | code | condition | position | row`);
    codes.push({ code: match[1], condition: match[2] });
  });
  const names = codes.map(entry => entry.code);
  const twice = names.find((name, index) => names.indexOf(name) !== index);
  if (twice !== undefined) throw new Error(`${CATALOG} names ${twice} twice`);
  if (!codes.length) throw new Error(`${CATALOG} names no code`);
  return codes;
}

// The words of a code that keep their capitals in a Go identifier, as Go writes initialisms: LexInvalidUTF8, DataInvalidJSON.
const GO_INITIALISMS = new Set(['UTF8', 'JSON']);

/** The Go identifier of a code: each word after E_ with a capital first letter, initialisms in capitals. */
export function goName(code: string): string {
  return code.slice(2).split('_').map(word => (GO_INITIALISMS.has(word) ? word : word.charAt(0) + word.slice(1).toLowerCase())).join('');
}

/** A block of a source file: the comment syntax of its marker lines, the indentation of the markers and its lines. */
type Block = { comment: string; indent: string; lines: (codes: CatalogCode[]) => string[] };

/** The list of an implementation: a source file with generated blocks, or a whole generated file. */
type Artifact = { file: string; blocks?: Block[]; whole?: (codes: CatalogCode[]) => string };

// The first lines of each whole generated file, without their comment syntax.
const HEADER = [`Generated by scripts/generate-error-codes.mts from the code tables of ${CATALOG};`, 'do not edit. Regenerate with make error-codes.'];

export const ARTIFACTS: Artifact[] = [
  {
    file: 'packages/ts/src/errors.ts',
    blocks: [{ comment: '//', indent: '  ', lines: codes => codes.map(({ code }, index) => `  | '${code}'${index === codes.length - 1 ? ';' : ''}`) }],
  },
  {
    file: 'packages/go/errs/errs.go',
    blocks: [{
      comment: '//',
      indent: '\t',
      lines: (codes) => {
        const width = Math.max(...codes.map(({ code }) => goName(code).length)) + 1;
        return codes.map(({ code }) => `\t${goName(code).padEnd(width)}Code = "${code}"`);
      },
    }],
  },
  {
    file: 'packages/rust/src/error.rs',
    blocks: [
      { comment: '//', indent: '    ', lines: codes => codes.flatMap(({ code, condition }) => [`    /// ${condition}`, `    ${code},`]) },
      { comment: '//', indent: '            ', lines: codes => codes.map(({ code }) => `            ErrorCode::${code} => "${code}",`) },
    ],
  },
  {
    file: 'packages/python/src/polyspec/template/errors.py',
    blocks: [{ comment: '#', indent: '    ', lines: codes => codes.map(({ code }) => `    "${code}",`) }],
  },
  {
    file: 'packages/php/src/ErrorCode.php',
    whole: codes => [
      '<?php',
      '',
      ...HEADER.map(line => `// ${line}`),
      '',
      'declare(strict_types=1);',
      '',
      'namespace Polyspec\\Template;',
      '',
      '/**',
      ' * The error codes of docs/spec/errors.md, each with the condition of its table row in ERR-7 to ERR-12.',
      ' */',
      'final class ErrorCode',
      '{',
      ...codes.flatMap(({ code, condition }, index) => [
        ...(index ? [''] : []),
        `    /** ${condition.replaceAll('*/', '*\\/')} */`,
        `    public const ${code} = '${code}';`,
      ]),
      '}',
      '',
    ].join('\n'),
  },
  {
    file: 'packages/php-ext/src/pt_error_codes.h',
    whole: codes => [
      `/* ${HEADER.join('\n * ')} */`,
      '#ifndef PT_ERROR_CODES_H',
      '#define PT_ERROR_CODES_H',
      '',
      '/* The error codes of docs/spec/errors.md (ERR-7 to ERR-12); the extension raises each error with one of them. */',
      ...codes.map(({ code }) => `#define PT_${code} "${code}"`),
      '',
      '#endif',
      '',
    ].join('\n'),
  },
];

const BEGIN = 'BEGIN GENERATED ERROR CODES';
const END = 'END GENERATED ERROR CODES';

/** The text of `source` with the lines of each of its generated blocks replaced, in order, the marker lines kept. */
export function replaceBlocks(source: string, blocks: Block[], codes: CatalogCode[], file: string): string {
  const lines = source.split('\n');
  const result: string[] = [];
  let index = 0;
  for (const block of blocks) {
    const begin = lines.findIndex((line, at) => at >= index && line === `${block.indent}${block.comment} ${BEGIN}`);
    const end = lines.findIndex((line, at) => at > begin && line === `${block.indent}${block.comment} ${END}`);
    if (begin < 0 || end < 0) throw new Error(`${file} needs the lines "${block.indent}${block.comment} ${BEGIN}" and "${block.indent}${block.comment} ${END}" for block ${blocks.indexOf(block) + 1} of ${blocks.length}`);
    result.push(...lines.slice(index, begin + 1), ...block.lines(codes));
    index = end;
  }
  result.push(...lines.slice(index));
  const markers = lines.filter(line => line.trim().endsWith(BEGIN)).length;
  if (markers !== blocks.length) throw new Error(`${file} holds ${markers} blocks of generated error codes; the generator writes ${blocks.length}`);
  return result.join('\n');
}

/** The bytes that `artifact` holds for `codes`, given the current text of its file. */
export function render(artifact: Artifact, codes: CatalogCode[], current: string): string {
  if (artifact.whole) return artifact.whole(codes);
  return replaceBlocks(current, artifact.blocks ?? [], codes, artifact.file);
}

/** Writes each artifact from the catalog under `root`, or with `check` writes nothing; returns the files that differed. */
export function run(root: string, check: boolean): string[] {
  const codes = parseCatalog(readFileSync(join(root, CATALOG), 'utf8'));
  const differing: string[] = [];
  for (const artifact of ARTIFACTS) {
    const path = join(root, artifact.file);
    const current = existsSync(path) ? readFileSync(path, 'utf8') : '';
    const next = render(artifact, codes, current);
    if (next === current) continue;
    differing.push(artifact.file);
    if (!check) writeFileSync(path, next);
  }
  return differing;
}

if (process.argv[1] !== undefined && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  const { values } = parseArgs({ options: { check: { type: 'boolean' } } });
  const differing = run(ROOT, values.check === true);
  if (values.check && differing.length) {
    console.error(`error-codes: the error codes of ${differing.join(', ')} differ from ${CATALOG}; run make error-codes`);
    process.exit(1);
  }
  console.log(values.check ? `error-codes: every list matches ${CATALOG}` : `error-codes: wrote ${differing.length ? differing.join(', ') : 'nothing'}`);
}
