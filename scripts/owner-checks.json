{
  "comment": "The owner checks of the repository paths (T13.1-4), read by scripts/owner-check.mjs: make owner-check runs the targets and node test files of the rules whose globs match a changed path. Every tracked path matches a rule; always lists the tests that run for every change. A rule with variable passes the matched paths to its targets in that make variable. Globs: * within one path segment, ** across segments, {a,b} either alternative.",
  "always": ["tests/scripts/editorconfig.test.mjs", "tests/scripts/toolchain-files.test.mjs"],
  "owners": [
    { "paths": ["docs/**", "*.md", "schema/*.md", "packages/*/README*.md"], "targets": ["docs-check", "docs-static-check"] },
    { "paths": ["contracts/features.json", "scripts/features/**"], "targets": ["feature-check", "docs-check"] },
    { "paths": ["contracts/functions.json", "tests/runner/function-contract.mjs", "scripts/check-function-contract.mjs"], "targets": ["function-contract-check"] },
    { "paths": ["config/dependency-policy.json", "config/dependency-review.json", "package.json", "package-lock.json", "packages/*/composer.{json,lock}", "scripts/check-dependency-policy*.mjs", "scripts/dependency-{state,review}.mjs"], "targets": ["dependency-policy-check"], "tests": ["tests/scripts/dependency-policy.test.mjs"] },
    { "paths": ["schema/ast.schema.json", "scripts/check-schema*.mjs", "scripts/conformance-case-files.mjs"], "targets": ["schema-check"] },
    { "paths": ["tests/rule-evidence.json", "scripts/check-rules.mjs"], "targets": ["rules-check"] },
    { "paths": ["tests/cases/**"], "targets": ["conformance-cases"], "variable": "CASES" },
    { "paths": ["tests/cases/**"], "targets": ["rules-check", "schema-check"] },
    { "paths": ["tests/fixtures/{bound-data,expr,native-object}/**"], "targets": ["test-ts", "test-go", "test-rust", "test-php", "test-ext"] },
    { "paths": ["tests/fixtures/{typed-arguments,typed-values}/**", "scripts/check-generated-{arguments,typed-values,native-calls,bound-data}.mjs"], "targets": ["generated-native-check"] },
    { "paths": ["tests/fixtures/function-inventory/**", "tests/runner/function-inventory.mjs", "scripts/inventory-template-functions.mjs"], "targets": ["function-inventory-check"] },
    { "paths": ["tests/browser/**", "playwright.config.ts"], "targets": ["test-browser"], "tests": ["tests/scripts/browser-port.test.mjs", "tests/scripts/browser-server.test.mjs"] },
    { "paths": ["tests/runner/{bounded,cases,drivers,conformance,delimiter-matrix,generated-ts-render,parity}.mjs", "tests/runner/conformance-generated-*.mjs"], "tests": ["tests/scripts/no-silent-skips.test.mjs", "tests/scripts/conformance-progress.test.mjs", "tests/scripts/delimiter-matrix-progress.test.mjs", "tests/scripts/generated-conformance.test.mjs", "tests/scripts/long-steps.test.mjs"] },
    { "paths": ["tests/scripts/*.test.mjs"], "tests": ["$path"] },
    { "paths": ["tests/scripts/slow-command.mjs", "scripts/run-tests.mjs", "scripts/test-progress/**", "scripts/tools.mjs"], "tests": ["tests/scripts/run-tests.test.mjs", "tests/scripts/test-targets.test.mjs"] },
    { "paths": ["Makefile"], "tests": ["tests/scripts/no-silent-skips.test.mjs", "tests/scripts/test-targets.test.mjs", "tests/scripts/full-run.test.mjs", "tests/scripts/cargo-target.test.mjs", "tests/scripts/build-package.test.mjs", "tests/scripts/owner-check.test.mjs", "tests/scripts/conformance-cases.test.mjs", "tests/scripts/suite-parity.test.mjs"] },
    { "paths": ["scripts/full-run.mjs"], "tests": ["tests/scripts/full-run.test.mjs"] },
    { "paths": ["tests/scripts/process-group.mjs"], "tests": ["tests/scripts/process-group.test.mjs", "tests/scripts/long-steps.test.mjs"] },
    { "paths": ["scripts/build-package.mjs"], "tests": ["tests/scripts/build-package.test.mjs"] },
    { "paths": ["scripts/owner-check.mjs", "scripts/owner-checks.json"], "tests": ["tests/scripts/owner-check.test.mjs"] },
    { "paths": ["scripts/conformance-cases.mjs"], "tests": ["tests/scripts/conformance-cases.test.mjs"] },
    { "paths": ["scripts/holder-lock.mjs"], "tests": ["tests/scripts/holder-lock.test.mjs"] },
    { "paths": ["scripts/install-cli.mjs"], "tests": ["tests/scripts/install-cli.test.mjs"] },
    { "paths": ["scripts/install-tools.mjs", "config/toolchain.json"], "tests": ["tests/scripts/install-tools.test.mjs", "tests/scripts/toolchain-files.test.mjs"] },
    { "paths": ["scripts/check-documents.mjs"], "targets": ["docs-check"], "tests": ["tests/scripts/check-documents.test.mjs"] },
    { "paths": ["scripts/check-docs-static.mjs"], "targets": ["docs-static-check"] },
    { "paths": ["scripts/check-doc-coverage.mjs", "scripts/update-benchmark-docs.mjs"], "targets": ["docs-check"] },
    { "paths": ["scripts/generate-runtime-interface.mjs", "scripts/check-runtime-interface.mjs"], "targets": ["runtime-interface-check"] },
    { "paths": ["scripts/generate-compiler-interface.mjs", "scripts/check-compiler-interface*.mjs"], "targets": ["compiler-interface-check"] },
    { "paths": ["scripts/generate-showcase-contract.mjs", "scripts/check-showcase-contract.mjs"], "targets": ["contract-check"] },
    { "paths": ["scripts/check-showcase-html.mjs", "tools/showcase/**", "examples/site/**"], "targets": ["showcase-check"] },
    { "paths": ["scripts/check-ast-artifact.mjs", "scripts/check-generated-artifact.mjs", "scripts/check-compiler-ir.mjs", "scripts/check-conformance-type-manifest.mjs"], "targets": ["compiler-ir-check"] },
    { "paths": ["scripts/check-typed-generator.mjs"], "targets": ["typed-generator-compile-check"] },
    { "paths": ["scripts/temporary-workspace.mjs"], "targets": ["generated-native-check", "typed-generator-compile-check"], "tests": ["tests/scripts/temporary-files.test.mjs", "tests/scripts/generated-conformance.test.mjs"] },
    { "paths": ["scripts/check-language-test-matrix*.mjs"], "targets": ["language-test-matrix"] },
    { "paths": ["scripts/check-editor-boundaries.mjs", "scripts/editor-fixtures.mjs"], "targets": ["editor-boundary-check", "test-language", "test-lsp", "test-codemirror"] },
    { "paths": ["scripts/check-install-workspace.mjs", "scripts/install-workspace.mjs", "scripts/check-package-installs.mjs"], "targets": ["install-check"], "tests": ["tests/scripts/long-steps.test.mjs", "tests/scripts/package-installs.test.mjs"] },
    { "paths": ["scripts/check-benchmark-results.mjs", "scripts/check-benchmark-smoke.mjs"], "targets": ["benchmark-check"] },
    { "paths": ["scripts/check-clean-release.mjs"], "tests": ["tests/scripts/clean-release.test.mjs"] },
    { "paths": ["tools/compiler/**"], "targets": ["compiler-ir-check", "compiler-interface-check", "typed-generator-compile-check", "contract-check"] },
    { "paths": ["packages/template-ts/**"], "targets": ["test-ts", "lint-js"] },
    { "paths": ["packages/template-language/**"], "targets": ["test-language", "format-check", "lint-js"] },
    { "paths": ["packages/template-lsp/**"], "targets": ["test-lsp", "lint-js"] },
    { "paths": ["packages/template-codemirror/**"], "targets": ["test-codemirror", "lint-js"] },
    { "paths": ["packages/template-vscode/**"], "targets": ["test-vscode", "lint-js"] },
    { "paths": ["packages/template-go/**"], "targets": ["test-go"] },
    { "paths": ["packages/template-rust/**"], "targets": ["test-rust"] },
    { "paths": ["packages/template-php/**"], "targets": ["test-php"] },
    { "paths": ["packages/template-php-ext/**"], "targets": ["test-ext"] },
    { "paths": ["eslint.config.mjs"], "targets": ["lint-js"] },
    { "paths": [".npmrc"], "tests": ["tests/scripts/no-symlinks.test.mjs"] },
    { "paths": [".node-version", "rust-toolchain.toml", ".github/workflows/*.yml", "packages/template-go/go.mod"], "tests": ["tests/scripts/toolchain-files.test.mjs"] },
    { "paths": [".github/workflows/*.yml"], "tests": ["tests/scripts/suite-parity.test.mjs"] },
    { "paths": [".gitignore"], "tests": ["tests/scripts/ignored-files.test.mjs"] },
    { "paths": [".editorconfig"], "tests": ["tests/scripts/editorconfig.test.mjs"] }
  ]
}
