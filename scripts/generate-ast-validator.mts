#!/usr/bin/env node
// Generates the validator of the template AST of packages/ts (AST-10, T25.6-2): ajv's standalone validation code
// (ajv/dist/standalone) of contracts/schema/ast.schema.json, compiled with the options of decodeTemplate, bundled by esbuild
// with the modules of ajv/dist/runtime that the code requires into one ES module without imports. The package therefore
// has no runtime dependency on ajv, compiles no code at run time (no `new Function`, so a Content-Security-Policy without
// 'unsafe-eval' allows it), and a browser loads it as it is. make build-ts checks it before the build (make
// ast-validator-check); make ast-validator writes it.
//
// Usage: node scripts/generate-ast-validator.mts [--check]
import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, join, relative, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { parseArgs } from 'node:util';
import { Ajv } from 'ajv';
// A CommonJS module: its exports, whose default is the function standaloneCode.
import standalone from 'ajv/dist/standalone/index.js';
import { build } from 'esbuild';

const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const SCHEMA = join(root, 'contracts/schema/ast.schema.json');
const OUTPUT = join(root, 'packages/ts/src/ast-validator.mjs');
const { values } = parseArgs({ options: { check: { type: 'boolean' } } });

const schemaText = readFileSync(SCHEMA, 'utf8');
const schema: unknown = JSON.parse(schemaText);
if (typeof schema !== 'object' || schema === null) throw new Error(`${relative(root, SCHEMA)} is not a JSON Schema object`);
// The options of the validator: strict schema checks, and every error, so that decodeTemplate chooses the deepest one.
const ajv = new Ajv({ strict: true, allErrors: true, code: { source: true, esm: true } });
ajv.addSchema(schema, 'ast');
const source = standalone.default(ajv, { validateTemplate: 'ast' });

const bundled = await build({
  stdin: { contents: source, resolveDir: root, sourcefile: 'ast-validator.mjs', loader: 'js' },
  bundle: true,
  format: 'esm',
  platform: 'neutral',
  target: 'es2022',
  write: false,
  logLevel: 'error',
});
const [file] = bundled.outputFiles;
if (file === undefined || bundled.outputFiles.length !== 1) throw new Error('esbuild wrote no single bundle of the AST validator');
// The ignore of config/knip-entries.json keeps the file out of knip and oxlint (kit K172), so the header disables no rule.
const header = '// Generated by scripts/generate-ast-validator.mts from contracts/schema/ast.schema.json with ajv standalone\n'
  + '// validation code; do not edit. Regenerate with make ast-validator.\n';
const content = header + file.text;

const path = relative(root, OUTPUT);
if (values.check) {
  if (!existsSync(OUTPUT) || readFileSync(OUTPUT, 'utf8') !== content) {
    console.error(`ast-validator: ${path} is stale; run make ast-validator`);
    process.exit(1);
  }
  console.log(`ast-validator: ${path} is current`);
} else {
  writeFileSync(OUTPUT, content);
  console.log(`ast-validator: wrote ${path}`);
}
