{
    "name": "polyspec/template-workspace",
    "description": "Development root of the Composer packages of packages/; never published",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "polyspec/template": "0.0.13"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "opis/json-schema": "2.6.0-p1",
        "phpunit/phpunit": "13.4.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Template\\Tests\\": "packages/php/tests/",
            "Polyspec\\Template\\Native\\Tests\\": "packages/php-ext/tests/",
            "Polyspec\\Showcase\\Adapter\\": "examples/showcase/adapters/generated/php-adapter/",
            "Polyspec\\Showcase\\Adapter\\Php\\": "examples/showcase/adapters/php/",
            "Polyspec\\Showcase\\Generated\\CompilerCoverage\\": "examples/showcase/adapters/generated/php/compiler-coverage/",
            "Polyspec\\Showcase\\Generated\\EmptyState\\": "examples/showcase/adapters/generated/php/empty-state/",
            "Polyspec\\Showcase\\Generated\\HtmlSlot\\": "examples/showcase/adapters/generated/php/html-slot/",
            "Polyspec\\Showcase\\Generated\\ReactBoundary\\": "examples/showcase/adapters/generated/php/react-boundary/",
            "Polyspec\\Showcase\\Generated\\ScopePrecedence\\": "examples/showcase/adapters/generated/php/scope-precedence/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/php"
        },
        {
            "type": "vcs",
            "url": "https://github.com/min-0-max/json-schema",
            "no-api": true
        }
    ],
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true
    }
}
