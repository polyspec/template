      "id": "spec",
      "title": "Template language specification",
      "title_ko": "Template language specification",
      "status": "implemented",
      "description": "Define lexical, grammar, expression, data-model, function, runtime, AST, error and conformance behavior.",
      "description_ko": "렉시컬, 문법, 표현식, 데이터 모델, 함수, 런타임, AST, 오류와 적합성 동작을 정의한다.",
      "inputs": {
        "type": "TemplateSource",
        "fields": [
          "UTF-8 source",
          "delimiters",
          "assign",
          "define"
        ]
      },
      "outputs": {
        "type": "RenderedProgram",
        "fields": [
          "canonical AST",
          "HTML bytes",
          "structured error"
        ]
      },
      "state": [
        "read source graph",
        "lex and parse",
        "validate types",
        "compile program",
        "render request"
      ],
      "errors": [
        {
          "code": "E_PARSE_*",
          "when": "source violates lexical or grammar rules"
        },
        {
          "code": "E_RUNTIME_*",
          "when": "rendering violates value or resource rules"
        }
      ],
      "clients": {
        "go": "pass",
        "php": "pass",
        "rust": "pass",
        "typescript": "pass"
      },
      "fixtures": [
        "tests/cases",
        "tests/fixtures/expr/cases.json"
