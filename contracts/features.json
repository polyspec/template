      "outputs": {
        "type": "FormattedTemplate",
        "fields": [
          "formatted text",
          "changed flag",
          "positioned error",
          "exit status"
        ]
      },
      "state": [
        "parse source",
        "format tag bodies",
        "parse result",
        "compare ASTs without spans",
        "write or report"
